13:T17ca,{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://pulse.smatchroom.com/prospection-b2b#webpage","url":"https://pulse.smatchroom.com/prospection-b2b","name":"Agence de prospection B2B : la prospection commerciale automatisée","description":"Agence de prospection B2B : un agent contacte vos prospects, qualifie le besoin et le budget, puis passe la main à vos commerciaux. Prix affichés.","inLanguage":"fr-FR","isPartOf":{"@id":"https://pulse.smatchroom.com/#website"},"about":{"@id":"https://pulse.smatchroom.com/#organization"},"breadcrumb":{"@id":"https://pulse.smatchroom.com/prospection-b2b#breadcrumb"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Accueil","item":"https://pulse.smatchroom.com/"},{"@type":"ListItem","position":2,"name":"Prospection B2B","item":"https://pulse.smatchroom.com/prospection-b2b"}],"@id":"https://pulse.smatchroom.com/prospection-b2b#breadcrumb"},{"@type":"Service","name":"Prospection commerciale B2B automatisée","description":"Agence de prospection B2B : un agent contacte vos prospects, qualifie le besoin et le budget, puis passe la main à vos commerciaux. Prix affichés.","url":"https://pulse.smatchroom.com/prospection-b2b","@id":"https://pulse.smatchroom.com/prospection-b2b#service","serviceType":"Prospection commerciale B2B automatisée","provider":{"@id":"https://pulse.smatchroom.com/#organization"},"areaServed":[{"@type":"AdministrativeArea","name":"Gironde"},{"@type":"AdministrativeArea","name":"Landes"},{"@type":"AdministrativeArea","name":"Pyrénées-Atlantiques"},{"@type":"AdministrativeArea","name":"Lot-et-Garonne"},{"@type":"AdministrativeArea","name":"Dordogne"},{"@type":"AdministrativeArea","name":"Charente-Maritime"},{"@type":"Country","name":"France"}],"offers":[{"@type":"Offer","name":"Fabrication","price":"300","priceCurrency":"EUR","valueAddedTaxIncluded":false,"description":"Frais de fabrication, une seule fois"},{"@type":"Offer","name":"Pilotage mensuel","priceCurrency":"EUR","valueAddedTaxIncluded":false,"priceSpecification":{"@type":"UnitPriceSpecification","price":"190","priceCurrency":"EUR","billingIncrement":1,"unitCode":"MON","unitText":"mois"}}]},{"@type":"Service","name":"Agent Clients B2B","description":"Base de données construite sur mesure pour votre marché, agent entraîné sur votre catalogue et vos objections, qualification du besoin, du budget et du calendrier avant transmission à vos commerciaux.","url":"https://pulse.smatchroom.com/prospection-b2b","@id":"https://pulse.smatchroom.com/prospection-b2b#service","serviceType":"Agent Clients B2B","provider":{"@id":"https://pulse.smatchroom.com/#organization"},"areaServed":[{"@type":"AdministrativeArea","name":"Gironde"},{"@type":"AdministrativeArea","name":"Landes"},{"@type":"AdministrativeArea","name":"Pyrénées-Atlantiques"},{"@type":"AdministrativeArea","name":"Lot-et-Garonne"},{"@type":"AdministrativeArea","name":"Dordogne"},{"@type":"AdministrativeArea","name":"Charente-Maritime"},{"@type":"Country","name":"France"}],"offers":[{"@type":"Offer","name":"Fabrication","price":"1800","priceCurrency":"EUR","valueAddedTaxIncluded":false,"description":"Frais de fabrication, une seule fois"},{"@type":"Offer","name":"Pilotage mensuel","priceCurrency":"EUR","valueAddedTaxIncluded":false,"priceSpecification":{"@type":"UnitPriceSpecification","price":"490","priceCurrency":"EUR","billingIncrement":1,"unitCode":"MON","unitText":"mois"}}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Combien coûte une agence de prospection B2B ?","acceptedAnswer":{"@type":"Answer","text":"Chez nous, deux formules. L'agent de prospection est à 300 € HT de fabrication puis 190 € HT par mois. L'Agent Clients B2B, avec base de données sur mesure et qualification avant transmission aux commerciaux, est à 1 800 € HT puis 490 € HT par mois. Pas de commission au rendez-vous, pas de facturation à la performance."}},{"@type":"Question","name":"Quelle différence avec un SDR ou un commercial junior ?","acceptedAnswer":{"@type":"Answer","text":"Le coût et la régularité. Un agent ne prend pas de retard sur les relances, ne décroche pas, et ne perd pas le fil d'une conversation de trois semaines. En revanche il ne négocie pas et ne signe rien : il amène l'interlocuteur qualifié jusqu'à votre commercial, qui garde la vente."}},{"@type":"Question","name":"D’où viennent les contacts ?","acceptedAnswer":{"@type":"Answer","text":"De données publiques : registres d'entreprises, annuaires professionnels, sources ouvertes de votre secteur. Nous n'achetons pas de fichiers et nous ne collectons pas de données de particuliers. Chaque contact est rattaché à une entreprise identifiée."}},{"@type":"Question","name":"Est-ce que c’est légal, et conforme au RGPD ?","acceptedAnswer":{"@type":"Answer","text":"La prospection entre professionnels est autorisée si l'objet du message concerne l'activité de la personne contactée, si l'expéditeur est identifiable et si l'opposition est possible et immédiate. Les trois sont tenues. Le caractère automatisé de l'envoi est mentionné, et toute opposition est définitive."}},{"@type":"Question","name":"Combien de messages par jour ?","acceptedAnswer":{"@type":"Answer","text":"On démarre bas et on monte progressivement. Un volume élevé dès le premier jour fait tomber le canal, quelle que soit la qualité du message. Le rythme se règle avec vous, il n'est jamais imposé."}},{"@type":"Question","name":"Qu’est-ce que je relis avant que ça parte ?","acceptedAnswer":{"@type":"Answer","text":"Les premiers messages, systématiquement. Ensuite vous gardez la main : vous voyez les conversations en cours et vous pouvez reprendre n'importe laquelle à tout moment."}},{"@type":"Question","name":"En combien de temps est-ce en service ?","acceptedAnswer":{"@type":"Answer","text":"48 heures pour un agent branché sur des données publiques. Une connexion à votre CRM ou à votre ERP demande plus de cadrage, et la fourchette est donnée après le premier échange."}}]}]}a:["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$13"}}],"$L14","$L15","$L16"],["$L17"],"$L18"]}]
