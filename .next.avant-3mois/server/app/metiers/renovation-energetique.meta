{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/metiers/layout,_N_T_/metiers/[slug]/layout,_N_T_/metiers/[slug]/page,_N_T_/metiers/renovation-energetique"
  },
