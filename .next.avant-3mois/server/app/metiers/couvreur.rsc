1e:Tc92,{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://pulse.smatchroom.com/metiers/couvreur#webpage","url":"https://pulse.smatchroom.com/metiers/couvreur","name":"Agent IA de prospection pour couvreurs · SmatchRoom Pulse","description":"Un agent IA qui va chercher des chantiers de couverture pour vous : il contacte agences, syndics et assureurs de votre zone, répond en une minute, vous passe la main. 300 € puis 190 €/mois.","inLanguage":"fr-FR","isPartOf":{"@id":"https://pulse.smatchroom.com/#website"},"about":{"@id":"https://pulse.smatchroom.com/#organization"},"breadcrumb":{"@id":"https://pulse.smatchroom.com/metiers/couvreur#breadcrumb"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Accueil","item":"https://pulse.smatchroom.com/"},{"@type":"ListItem","position":2,"name":"Métiers","item":"https://pulse.smatchroom.com/metiers"},{"@type":"ListItem","position":3,"name":"Couvreurs et charpentiers","item":"https://pulse.smatchroom.com/metiers/couvreur"}],"@id":"https://pulse.smatchroom.com/metiers/couvreur#breadcrumb"},{"@type":"Service","name":"Agent IA de prospection pour couvreurs","description":"Un agent IA qui va chercher des chantiers de couverture pour vous : il contacte agences, syndics et assureurs de votre zone, répond en une minute, vous passe la main. 300 € puis 190 €/mois.","url":"https://pulse.smatchroom.com/metiers/couvreur","@id":"https://pulse.smatchroom.com/metiers/couvreur#service","serviceType":"Agent IA de prospection pour couvreurs","provider":{"@id":"https://pulse.smatchroom.com/#organization"},"areaServed":[{"@type":"AdministrativeArea","name":"Gironde"},{"@type":"AdministrativeArea","name":"Landes"},{"@type":"AdministrativeArea","name":"Pyrénées-Atlantiques"},{"@type":"AdministrativeArea","name":"Lot-et-Garonne"},{"@type":"AdministrativeArea","name":"Dordogne"},{"@type":"AdministrativeArea","name":"Charente-Maritime"},{"@type":"Country","name":"France"}],"offers":[{"@type":