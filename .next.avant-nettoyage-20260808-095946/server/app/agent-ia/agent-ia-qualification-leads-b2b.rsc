4e:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Setup initial"}]," : de 490 € (périmètre cadré, 1 agent) à plusieurs milliers d'euros pour des architectures multi-agents avec connecteurs CRM sur mesure"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Abonnement mensuel"}]," : de 249 €/mois pour un dispositif pilote à 690 €/mois pour un squad d'agents orchestrés ; les solutions enterprise dépassent souvent 2 000 €/mois"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Coût par lead qualifié estimé"}]," : entre 0,80 € et 4 € selon le volume traité et le niveau d'enrichissement (données tierces, vérification email, scoring BANT)"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Intégrations tierces"}]," : prévoir 0 à 300 €/mois supplémentaires si l'agent consomme des API d'enrichissement (Clearbit, Kaspr, Dropcontact)"]}],"\n"]}]
