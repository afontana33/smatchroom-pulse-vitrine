40:["$","h3",null,{"id":"intégration-crm-native-ou-via-api","children":["$","a",null,{"href":"#intégration-crm-native-ou-via-api","children":"Intégration CRM native ou via API"}]}]
41:["$","p",null,{"children":["Un agent qui ne s'inscrit pas directement dans votre stack (HubSpot, Salesforce, Pipedrive, Zoho) génère des doubles saisies et des données orphelines. Vérifiez la profondeur de l'intégration : lecture ",["$","strong",null,{"children":"et"}]," écriture des champs personnalisés, déclenchement de workflows, synchronisation bidirectionnelle en temps réel."]}]
42:["$","h3",null,{"id":"personnalisation-des-règles-de-scoring","children":["$","a",null,{"href":"#personnalisation-des-règles-de-scoring","children":"Personnalisation des règles de scoring"}]}]
43:["$","p",null,{"children":"Les frameworks BANT ou MEDDIC ne s'appliquent pas de la même façon selon votre cycle de vente. L'agent doit accepter vos propres critères de qualification — secteur cible, taille d'entreprise, budget plancher, signaux comportementaux — sans nécessiter un développement sur mesure à chaque ajustement."}]
44:["$","h3",null,{"id":"supervision-humaine-et-auditabilité","children":["$","a",null,{"href":"#supervision-humaine-et-auditabilité","children":"Supervision humaine et auditabilité"}]}]
45:["$","p",null,{"children":"Selon une estimation prudente, 10 à 15 % des leads entrants présentent des signaux ambigus qui nécessitent un arbitrage humain. Votre agent doit proposer :"}]
46:["$","ul",null,{"children":["\n",["$","li",null,{"children":"un tableau de bord de supervision en temps réel"}],"\n",["$","li",null,{"children":"un historique des décisions de scoring consultable"}],"\n",["$","li",null,{"children":"une escalade configurable vers un SDR dès qu'un seuil d'incertitude est atteint"}],"\n"]}]
