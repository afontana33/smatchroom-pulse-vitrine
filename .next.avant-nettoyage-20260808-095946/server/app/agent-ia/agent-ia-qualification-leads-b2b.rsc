4b:["$","h2",null,{"id":"quel-budget-prévoir-pour-déployer-un-agent-ia-de-qualification-leads-b2b","children":["$","a",null,{"href":"#quel-budget-prévoir-pour-déployer-un-agent-ia-de-qualification-leads-b2b","children":"Quel budget prévoir pour déployer un agent IA de qualification leads B2B"}]}]
4c:["$","p",null,{"children":"Le coût total d'un agent IA de qualification se décompose en trois postes : les frais de setup (paramétrage, intégration CRM, définition des règles de scoring), l'abonnement mensuel récurrent et, selon les volumes, un coût par lead qualifié traité."}]
