a:["$","section",null,{"className":"px-5 pb-28 sm:px-6","children":["$","div",null,{"className":"mx-auto max-w-5xl","children":[["$","$L3",null,{"children":["$","div",null,{"className":"mb-10 text-center","children":[["$","p",null,{"className":"eyebrow","children":"Ils utilisent Pulse"}],["$","h2",null,{"className":"mt-3 text-balance text-3xl font-semibold tracking-tight","children":["$","span",null,{"className":"gradient-text","children":"Ce qu'ils en disent"}]}]]}]}],["$","div",null,{"className":"grid gap-6 md:grid-cols-2","children":[["$","div","Mathieu Lescut",{"className":"card card-hover p-8","children":[["$","p",null,{"className":"text-sm leading-relaxed text-[var(--muted-strong)] italic","children":["« ","En trois semaines, l'assistant m'a mis en contact avec des promoteurs et des gestionnaires de copropriétés que je n'aurais jamais démarché seul. Ces partenaires m'ont déjà apporté plusieurs chantiers. Le retour sur investissement est là."," »"]}],["$","div",null,{"className":"mt-5 flex items-center gap-3 border-t border-[var(--border)] pt-4","children":[["$","div",null,{"className":"flex h-9 w-9 items-center justify-center rounded-full bg-[var(--primary-soft)] font-mono text-sm font-semibold text-[var(--primary-ink)] ring-1 ring-[var(--primary-line)]","children":"M"}],["$","div",null,{"children":[["$","p",null,{"className":"text-sm font-medium text-[var(--foreground)]","children":"Mathieu Lescut"}],["$","p",null,{"className":"text-xs text-[var(--muted)]","children":"Franchisé Tryba · Pau"}]]}]]}]]}],["$","div","Karim Bensalem",{"className":"card card-hover p-8","children":[["$","p",null,{"className":"text-sm leading-relaxed text-[var(--muted-strong)] italic","children":["« ","Je n'avais pas le temps de faire du réseau. J'ai branché l'agent Pulse la semaine dernière : il a décroché 3 nouveaux partenariats locaux avec des apporteurs d'affaires en seulement 7 jours. La machine tourne toute seule en arrière-plan."," »"]}],["$","div",null,{"className":"mt-5 flex