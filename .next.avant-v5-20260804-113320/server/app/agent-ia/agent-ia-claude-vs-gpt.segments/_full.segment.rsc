47:["$","p",null,{"children":"Chez SmatchRoom, le choix du modèle — Claude, GPT-4o, Mistral ou autre — n'est jamais décidé en amont du diagnostic. Il découle d'une grille d'analyse appliquée à chaque périmètre métier, sans préférence technologique figée."}]
48:["$","p",null,{"children":["$","strong",null,{"children":"Les critères évalués à chaque projet :"}]}]
49:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Volume et nature des documents traités"}]," : contrats longs, exports CRM, tickets multilingues → fenêtre de contexte déterminante"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Tolérance au risque d'erreur"}]," : un agent SDR peut se permettre une reformulation approximative ; un agent ops sur des données financières, non"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Fréquence et coût des appels API"}]," : pour un agent à fort volume (>10 000 appels/mois), l'écart tarifaire entre modèles devient structurant"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Contraintes de souveraineté et d'hébergement"}]," : certains secteurs (santé, juridique, finance) imposent des exigences de localisation des données"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Latence acceptable"}]," : un agent support temps réel n'a pas les mêmes contraintes qu'un agent d'enrichissement nocturne"]}],"\n"]}]
4a:["$","p",null,{"children":["$","strong",null,{"children":"Ce que cela change concrètement :"}]}]
4b:["$","p",null,{"children":"Un agent support e-commerce déployé en offre Pilote tournera souvent sur GPT-4o Mini pour maîtriser les coûts. Un agent d'analyse contractuelle en Squad privilégiera Claude 3.5 Sonnet pour sa fenêtre de contexte étendue et sa précision sur les documents denses."}]
4c:["$","p",null,{"children":"Cette approche model-agnostique protège vos investissements : si un modèle plus performant ou moins coûteux émerge, la migration reste possible sans refonte de l'architecture."}]
