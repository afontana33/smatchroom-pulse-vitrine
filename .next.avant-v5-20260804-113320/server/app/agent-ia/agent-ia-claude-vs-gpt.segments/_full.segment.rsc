3e:["$","p",null,{"children":["$","strong",null,{"children":"Modèle recommandé : Claude 3.5 Sonnet"}]}]
3f:["$","p",null,{"children":"Un agent support doit lire des historiques de conversation longs, croiser des bases de connaissance volumineuses et formuler des réponses précises sans dériver. Claude s'impose sur ce scénario :"}]
40:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Fenêtre de contexte de 200 000 tokens, adaptée aux exports CRM et aux threads de tickets complexes"}],"\n",["$","li",null,{"children":"Ton naturellement plus mesuré, réduisant le risque de réponse inadaptée en situation sensible"}],"\n",["$","li",null,{"children":"Taux de refus calibré : moins de faux positifs sur des requêtes légitimes mais formulées maladroitement"}],"\n"]}]
