3b:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Vitesse d'inférence supérieure pour des appels API répétés (plusieurs centaines par jour)"}],"\n",["$","li",null,{"children":"Excellente cohérence stylistique sur des variations de messages courts"}],"\n",["$","li",null,{"children":"Intégration native avec les outils de l'écosystème OpenAI (function calling, structured outputs)"}],"\n",["$","li",null,{"children":"Coût par token inférieur à Claude 3.5 Sonnet sur des volumes > 500 000 tokens/jour (estimation prudente, à valider selon grille tarifaire en vigueur)"}],"\n"]}]
3c:["$","p",null,{"children":"Pour un agent SDR traitant 200 leads/semaine, la différence de latence entre les deux modèles peut représenter 15 à 20 % de gain de débit opérationnel."}]
