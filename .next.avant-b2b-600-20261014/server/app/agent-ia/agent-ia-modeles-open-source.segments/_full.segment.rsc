31:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Avec un modèle propriétaire, vos données transitent chez un tiers (même sous accord DPA). Pour les secteurs réglementés — santé, finance, juridique — cela peut bloquer le déploiement."}],"\n",["$","li",null,{"children":["Un modèle open source hébergé sur votre infrastructure ou dans votre VPC garantit que ",["$","strong",null,{"children":"aucune donnée ne quitte votre périmètre"}],"."]}],"\n"]}]
32:["$","h3",null,{"id":"personnalisation-et-fine-tuning","children":["$","a",null,{"href":"#personnalisation-et-fine-tuning","children":"Personnalisation et fine-tuning"}]}]
33:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Les solutions propriétaires proposent un fine-tuning limité, souvent coûteux et opaque."}],"\n",["$","li",null,{"children":["Les modèles open source permettent un entraînement complet sur vos données métier : terminologie sectorielle, tonalité, processus internes. Le gain en précision sur des tâches spécialisées est estimé à ",["$","strong",null,{"children":"15–40 % selon les benchmarks de fine-tuning publiés par Mistral AI et Meta"}],"."]}],"\n"]}]
34:["$","h3",null,{"id":"dépendance-fournisseur-vendor-lock-in","children":["$","a",null,{"href":"#dépendance-fournisseur-vendor-lock-in","children":["Dépendance fournisseur (",["$","em",null,{"children":"vendor lock-in"}],")"]}]}]
35:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Un changement tarifaire ou une interruption de service chez un fournisseur propriétaire impacte directement votre production."}],"\n",["$","li",null,{"children":"L'open source vous donne la main sur le modèle, la version et le calendrier de migration — un levier stratégique non négligeable pour des agents en production critique."}],"\n"]}]
36:["$","blockquote",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"En résumé :"}]," les modèles propriétaires offrent une mise en route rapide ; l'open source rend la main sur les coûts, les données et la trajectoire technique à moyen terme."]}],"\n"]}]
37:["$","h2",null,{"id":"critères-techniques-pour-sélectionner-un-modèle-open-source-adapté-à-votre-cas-dusage-b2b","children":["$","a",null,{"href":"#critères-techniques-pour-sélectionner-un-modèle-open-source-adapté-à-votre-cas-dusage-b2b","children":"Critères techniques pour sélectionner un modèle open source adapté à votre cas d'usage B2B"}]}]
38:["$","p",null,{"children":"Cinq paramètres structurent la décision technique avant tout déploiement en production."}]
39:["$","h3",null,{"id":"taille-du-modèle--trouver-le-bon-équilibre-performanceressources","children":["$","a",null,{"href":"#taille-du-modèle--trouver-le-bon-équilibre-performanceressources","children":"Taille du modèle : trouver le bon équilibre performance/ressources"}]}]
3a:["$","p",null,{"children":"La taille (exprimée en milliards de paramètres) détermine directement la qualité des sorties et le coût d'inférence. En contexte B2B, trois paliers sont pertinents :"}]
3b:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"3–8 B paramètres"}]," (Phi-3 Mini, Mistral 7B) : adapté aux tâches structurées et répétitives — extraction de données, qualification de leads, routage de tickets"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"13–34 B paramètres"}]," (LLaMA 3 13B, Mistral 22B) : bon compromis pour le raisonnement multi-étapes et la génération de réponses nuancées"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"70 B+ paramètres"}]," (LLaMA 3 70B, Qwen2 72B) : réservé aux cas d'usage complexes justifiant une infrastructure GPU dédiée"]}],"\n"]}]
3c:["$","h3",null,{"id":"fenêtre-de-contexte","children":["$","a",null,{"href":"#fenêtre-de-contexte","children":"Fenêtre de contexte"}]}]
3d:["$","p",null,{"children":["Un agent SDR qui analyse un historique CRM ou un agent support qui lit un long fil de conversation nécessite une fenêtre de contexte étendue. Privilégiez les modèles offrant ",["$","strong",null,{"children":"32 000 tokens minimum"}]," ; certains cas d'usage documentaires exigent 128 000 tokens (Qwen2, LLaMA 3.1)."]}]
3e:["$","h3",null,{"id":"fine-tuning--nécessaire-ou-non-","children":["$","a",null,{"href":"#fine-tuning--nécessaire-ou-non-","children":"Fine-tuning : nécessaire ou non ?"}]}]
3f:["$","p",null,{"children":"Le fine-tuning améliore la cohérence sur un domaine métier précis (jargon sectoriel, format de sortie imposé). Il est justifié si :"}]
40:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Vos données propriétaires sont volumineuses et structurées"}],"\n",["$","li",null,{"children":"Le prompt engineering seul ne suffit pas à stabiliser les sorties"}],"\n",["$","li",null,{"children":"Vous visez une réduction de la taille du modèle à iso-performance"}],"\n"]}]
41:["$","p",null,{"children":["Comptez ",["$","strong",null,{"children":"plusieurs semaines de travail"}]," et un budget GPU non négligeable pour une itération sérieuse."]}]
42:["$","h3",null,{"id":"inférence-locale-vs-cloud","children":["$","a",null,{"href":"#inférence-locale-vs-cloud","children":"Inférence locale vs cloud"}]}]
43:["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Critère"}],["$","th",null,{"children":"On-premise / local"}],["$","th",null,{"children":"Cloud GPU managé"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":"Confidentialité des données"}],["$","td",null,{"children":"Maximale"}],["$","td",null,{"children":"Dépend du provider"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Coût fixe"}],["$","td",null,{"children":"Élevé (matériel)"}],["$","td",null,{"children":"Variable à l'usage"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Délai de mise en production"}],["$","td",null,{"children":"Plusieurs semaines"}],["$","td",null,{"children":"Quelques jours"}]]}]]}]]}]
44:["$","h3",null,{"id":"licences-commerciales--un-point-non-négociable","children":["$","a",null,{"href":"#licences-commerciales--un-point-non-négociable","children":"Licences commerciales : un point non négociable"}]}]
45:["$","p",null,{"children":"Toutes les licences open source n'autorisent pas l'usage commercial. Vérifiez systématiquement :"}]
46:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"LLaMA 3"}]," : licence Meta autorisant l'usage commercial sous conditions (seuil de 700 M d'utilisateurs actifs mensuels)"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Mistral"}]," : licence Apache 2.0, usage commercial libre"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Falcon"}]," : licence TII autorisant l'usage commercial"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Phi-3"}]," : licence MIT, la plus permissive"]}],"\n"]}]
47:["$","p",null,{"children":"Ignorer ce point expose votre entreprise à un risque juridique réel."}]
48:["$","h2",null,{"id":"maîtriser-les-coûts-dinfrastructure--hébergement-gpu-et-alternatives-managées","children":["$","a",null,{"href":"#maîtriser-les-coûts-dinfrastructure--hébergement-gpu-et-alternatives-managées","children":"Maîtriser les coûts d'infrastructure : hébergement, GPU et alternatives managées"}]}]
49:["$","p",null,{"children":"Le poste de coût le plus sous-estimé dans un déploiement open source n'est pas le modèle — c'est l'infrastructure qui le fait tourner. Selon les configurations, l'écart entre une architecture optimisée et une architecture mal dimensionnée peut représenter un facteur 5 à 10 sur la facture mensuelle."}]
4a:["$","h3",null,{"id":"les-trois-grandes-options-dhébergement","children":["$","a",null,{"href":"#les-trois-grandes-options-dhébergement","children":"Les trois grandes options d'hébergement"}]}]
4b:["$","p",null,{"children":["$","strong",null,{"children":"On-premise (serveur dédié)"}]}]
4c:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Investissement initial élevé : une carte NVIDIA A100 80 Go coûte entre 10 000 € et 15 000 € à l'achat"}],"\n",["$","li",null,{"children":"Pertinent uniquement si le volume de requêtes est constant et élevé (>500 000 tokens/jour)"}],"\n",["$","li",null,{"children":"Avantage décisif : confidentialité totale des données, aucun transit externe"}],"\n"]}]
4d:["$","p",null,{"children":["$","strong",null,{"children":"Cloud GPU à la demande (AWS, GCP, Azure, Lambda Labs)"}]}]
4e:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Facturation à l'heure : une instance A10G sur AWS tourne entre 1,50 $ et 3,50 $/heure"}],"\n",["$","li",null,{"children":"Adapté aux charges variables ou aux phases de test"}],"\n",["$","li",null,{"children":"Risque : les coûts peuvent déraper sans politique d'auto-scaling rigoureuse"}],"\n"]}]
4f:["$","p",null,{"children":["$","strong",null,{"children":"Providers managés spécialisés"}]}]
50:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Together AI"}]," : inférence LLaMA 3 70B à ~0,90 $/million de tokens (estimation mai 2025)"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Groq"}]," : latence ultra-faible grâce aux puces LPU, idéal pour les agents conversationnels temps réel"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Ollama"}]," : exécution locale sur CPU/GPU grand public, adapté aux prototypes et aux petits volumes"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Replicate, Fireworks AI"}]," : alternatives compétitives pour les équipes sans DevOps dédié"]}],"\n"]}]
51:["$","h3",null,{"id":"règles-de-dimensionnement-à-retenir","children":["$","a",null,{"href":"#règles-de-dimensionnement-à-retenir","children":"Règles de dimensionnement à retenir"}]}]
52:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Un modèle 7B quantisé (GGUF Q4) tourne sur un GPU 8 Go — coût cloud : ~0,40 $/heure"}],"\n",["$","li",null,{"children":"Un modèle 70B nécessite au minimum 2 × A100 en parallèle"}],"\n",["$","li",null,{"children":"Le fine-tuning ponctuel coûte moins cher que l'inférence continue : séparez les deux budgets"}],"\n"]}]
53:["$","p",null,{"children":"Pour les entreprises B2B sans équipe MLOps interne, les providers managés offrent le meilleur compromis coût/fiabilité en phase de production initiale."}]
54:["$","h2",null,{"id":"exemples-concrets-dagents-ia-b2b-construits-sur-des-modèles-open-source","children":["$","a",null,{"href":"#exemples-concrets-dagents-ia-b2b-construits-sur-des-modèles-open-source","children":"Exemples concrets d'agents IA B2B construits sur des modèles open source"}]}]
55:["$","p",null,{"children":"Trois cas d'usage concentrent aujourd'hui l'essentiel des déploiements en production : la prospection commerciale (SDR), le support client, et l'automatisation des opérations internes. Dans chacun, des architectures basées sur des LLM open source démontrent des résultats mesurables."}]
56:["$","h3",null,{"id":"agent-sdr--prospection-et-qualification-de-leads","children":["$","a",null,{"href":"#agent-sdr--prospection-et-qualification-de-leads","children":"Agent SDR — Prospection et qualification de leads"}]}]
57:["$","p",null,{"children":["Un éditeur SaaS B2B peut déployer un agent de prospection outbound sur ",["$","strong",null,{"children":"Mistral 7B Instruct"}],", hébergé via Together AI, couplé à un outil d'enrichissement (Apollo, Clearbit) et un CRM (HubSpot)."]}]
58:["$","p",null,{"children":"Architecture type :"}]
59:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Récupération automatique des signaux d'intention (job postings, levées de fonds)"}],"\n",["$","li",null,{"children":"Génération de séquences d'e-mails personnalisées par segment ICP"}],"\n",["$","li",null,{"children":"Qualification des réponses entrantes et mise à jour du CRM sans intervention humaine"}],"\n",["$","li",null,{"children":"Escalade vers un commercial dès qu'un lead atteint un score défini"}],"\n"]}]
5a:["$","p",null,{"children":["Résultat observé sur ce type de configuration : ",["$","strong",null,{"children":"réduction de 60 % du temps de traitement manuel"}]," des leads entrants (estimation terrain, périmètre mid-market)."]}]
5b:["$","h3",null,{"id":"agent-support-client--résolution-de-tickets-de-niveau-1","children":["$","a",null,{"href":"#agent-support-client--résolution-de-tickets-de-niveau-1","children":"Agent support client — Résolution de tickets de niveau 1"}]}]
5c:["$","p",null,{"children":["Un intégrateur IT peut construire un agent support sur ",["$","strong",null,{"children":"LLaMA 3 8B"}],", fine-tuné sur sa base de connaissances interne, déployé on-premise pour garantir la confidentialité des données clients."]}]
5d:["$","p",null,{"children":"Architecture type :"}]
5e:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Lecture et classification automatique des tickets entrants"}],"\n",["$","li",null,{"children":"Recherche RAG dans la documentation technique et les historiques de résolution"}],"\n",["$","li",null,{"children":"Réponse autonome pour les cas résolus à ≥ 85 % de confiance"}],"\n",["$","li",null,{"children":"Transfert vers un technicien humain avec contexte pré-rempli pour les cas complexes"}],"\n"]}]
5f:["$","h3",null,{"id":"agent-ops--automatisation-des-processus-internes","children":["$","a",null,{"href":"#agent-ops--automatisation-des-processus-internes","children":"Agent ops — Automatisation des processus internes"}]}]
60:["$","p",null,{"children":["Un cabinet de conseil peut orchestrer un agent ops sur ",["$","strong",null,{"children":"Qwen2 72B"}]," pour automatiser le suivi de projet : extraction des comptes-rendus, mise à jour des tableaux de bord, détection des jalons à risque et alertes proactives aux chefs de projet."]}]
61:["$","p",null,{"children":["Ces trois architectures partagent un principe commun : ",["$","strong",null,{"children":"le modèle open source gère le raisonnement, les outils externes gèrent les données métier"}],". C'est cette séparation qui rend le système maintenable et évolutif."]}]
62:["$","h2",null,{"id":"limites-et-risques-à-anticiper-avant-de-déployer-un-modèle-open-source-en-production","children":["$","a",null,{"href":"#limites-et-risques-à-anticiper-avant-de-déployer-un-modèle-open-source-en-production","children":"Limites et risques à anticiper avant de déployer un modèle open source en production"}]}]
63:["$","p",null,{"children":"Déployer un modèle open source en production B2B n'est pas sans contraintes. Voici les risques concrets à évaluer avant de vous engager."}]
64:["$","h3",null,{"id":"maintenance-et-mises-à-jour","children":["$","a",null,{"href":"#maintenance-et-mises-à-jour","children":"Maintenance et mises à jour"}]}]
65:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Les mises à jour de modèles (nouvelles versions, correctifs de sécurité) sont à votre charge — aucun fournisseur ne les pousse automatiquement."}],"\n",["$","li",null,{"children":"Un modèle figé se dégrade progressivement face à des données métier qui évoluent."}],"\n",["$","li",null,{"children":["Estimation prudente : une équipe technique consacre en moyenne ",["$","strong",null,{"children":"15 à 20 % de son temps"}]," à la maintenance d'une infrastructure LLM open source en production."]}],"\n"]}]
66:["$","h3",null,{"id":"sécurité-et-conformité","children":["$","a",null,{"href":"#sécurité-et-conformité","children":"Sécurité et conformité"}]}]
67:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Les poids téléchargés publiquement peuvent contenir des biais ou des vulnérabilités non documentées."}],"\n",["$","li",null,{"children":"La conformité RGPD repose entièrement sur votre architecture d'hébergement — aucun tiers ne partage la responsabilité."}],"\n",["$","li",null,{"children":"Les audits de sécurité sont à initier et financer en interne."}],"\n"]}]
68:["$","h3",null,{"id":"performance-vs-modèles-de-classe-gpt-4","children":["$","a",null,{"href":"#performance-vs-modèles-de-classe-gpt-4","children":"Performance vs modèles de classe GPT-4"}]}]
69:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Sur des tâches de raisonnement complexe, de génération longue ou de compréhension multilingue fine, les modèles open source affichent encore un écart mesurable face aux modèles propriétaires frontier."}],"\n",["$","li",null,{"children":"Cet écart se réduit rapidement, mais reste significatif sur certains cas d'usage critiques (analyse contractuelle, escalade support complexe)."}],"\n"]}]
6a:["$","h3",null,{"id":"compétences-internes-requises","children":["$","a",null,{"href":"#compétences-internes-requises","children":"Compétences internes requises"}]}]
6b:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Déployer, monitorer et faire évoluer un LLM open source nécessite des profils MLOps ou DevOps IA — des ressources rares et coûteuses sur le marché."}],"\n",["$","li",null,{"children":"Sans ces compétences en interne, le recours à un intégrateur spécialisé devient incontournable."}],"\n"]}]
6c:["$","h2",null,{"id":"faq--modèles-open-source-pour-agents-ia-b2b","children":["$","a",null,{"href":"#faq--modèles-open-source-pour-agents-ia-b2b","children":"FAQ — Modèles open source pour agents IA B2B"}]}]
6d:["$","h3",null,{"id":"quels-modèles-open-source-sont-les-plus-fiables-pour-un-agent-ia-en-production-b2b-","children":["$","a",null,{"href":"#quels-modèles-open-source-sont-les-plus-fiables-pour-un-agent-ia-en-production-b2b-","children":"Quels modèles open source sont les plus fiables pour un agent IA en production B2B ?"}]}]
6e:["$","p",null,{"children":"LLaMA 3 (Meta), Mistral 7B et Mixtral 8x7B sont les références les plus déployées en production B2B en 2025. Ils offrent un bon équilibre entre performance, licence commerciale permissive et communauté active. Qwen 2 et Phi-3 (Microsoft) se distinguent sur les cas d'usage à contexte long ou à ressources contraintes."}]
6f:["$","h3",null,{"id":"un-modèle-open-source-peut-il-rivaliser-avec-gpt-4-pour-un-agent-sdr-ou-support-","children":["$","a",null,{"href":"#un-modèle-open-source-peut-il-rivaliser-avec-gpt-4-pour-un-agent-sdr-ou-support-","children":"Un modèle open source peut-il rivaliser avec GPT-4 pour un agent SDR ou support ?"}]}]
70:["$","p",null,{"children":"Sur des tâches bien délimitées — qualification de leads, réponse à une FAQ structurée, extraction d'informations — un modèle open source fine-tuné atteint des performances comparables à GPT-4, pour un coût d'inférence 5 à 10 fois inférieur. L'écart reste réel sur les tâches de raisonnement complexe ou multilingue avancé."}]
71:["$","h3",null,{"id":"faut-il-obligatoirement-des-compétences-mlops-internes-pour-déployer-un-modèle-open-source-","children":["$","a",null,{"href":"#faut-il-obligatoirement-des-compétences-mlops-internes-pour-déployer-un-modèle-open-source-","children":"Faut-il obligatoirement des compétences MLOps internes pour déployer un modèle open source ?"}]}]
72:["$","p",null,{"children":"Non, à condition de passer par un provider managé (Together AI, Groq, Hugging Face Inference Endpoints). Ces plateformes abstraient l'infrastructure GPU. Des compétences MLOps deviennent nécessaires uniquement si vous optez pour un hébergement on-premise ou un fine-tuning personnalisé."}]
73:["$","h3",null,{"id":"les-données-traitées-par-un-modèle-open-source-sont-elles-plus-sécurisées-","children":["$","a",null,{"href":"#les-données-traitées-par-un-modèle-open-source-sont-elles-plus-sécurisées-","children":"Les données traitées par un modèle open source sont-elles plus sécurisées ?"}]}]
74:["$","p",null,{"children":"Potentiellement oui : hébergé sur votre infrastructure ou dans votre VPC, le modèle ne transmet aucune donnée à un tiers. C'est l'argument principal pour les secteurs régulés (santé, finance, juridique). La sécurité réelle dépend cependant de votre configuration réseau et de vos pratiques DevSecOps."}]
75:["$","h3",null,{"id":"quelle-licence-vérifier-avant-dutiliser-un-modèle-open-source-en-contexte-commercial-","children":["$","a",null,{"href":"#quelle-licence-vérifier-avant-dutiliser-un-modèle-open-source-en-contexte-commercial-","children":"Quelle licence vérifier avant d'utiliser un modèle open source en contexte commercial ?"}]}]
76:["$","p",null,{"children":"Vérifiez systématiquement si la licence autorise l'usage commercial sans restriction. LLaMA 3 impose des conditions au-delà de 700 millions d'utilisateurs mensuels. Mistral et Phi-3 sont sous licences Apache 2.0, plus permissives. Une revue juridique est recommandée avant tout déploiement en production."}]
77:["$","h3",null,{"id":"quel-budget-prévoir-pour-héberger-un-modèle-open-source-dédié-à-un-agent-b2b-","children":["$","a",null,{"href":"#quel-budget-prévoir-pour-héberger-un-modèle-open-source-dédié-à-un-agent-b2b-","children":"Quel budget prévoir pour héberger un modèle open source dédié à un agent B2B ?"}]}]
78:["$","p",null,{"children":"Un modèle 7B en inférence cloud managée coûte entre 0,10 € et 0,30 € par million de tokens. Pour un usage intensif (>10 millions de tokens/mois), un GPU dédié (A100 loué ~2,50 €/h) devient plus économique. Un pilote à faible volume peut démarrer sous 100 €/mois d'infrastructure."}]
