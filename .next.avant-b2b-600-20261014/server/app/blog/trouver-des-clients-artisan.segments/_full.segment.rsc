1b:T748,{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://pulse.smatchroom.com/blog/trouver-des-clients-artisan#webpage","url":"https://pulse.smatchroom.com/blog/trouver-des-clients-artisan","name":"Comment trouver des clients en tant qu'artisan : 6 canaux","description":"Les six canaux qui ramènent des chantiers à un artisan du bâtiment, ce qu'ils coûtent, et dans quel ordre les mettre en place quand on est seul.","inLanguage":"fr-FR","isPartOf":{"@id":"https://pulse.smatchroom.com/#website"},"about":{"@id":"https://pulse.smatchroom.com/#organization"},"breadcrumb":{"@id":"https://pulse.smatchroom.com/blog/trouver-des-clients-artisan#breadcrumb"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Accueil","item":"https://pulse.smatchroom.com/"},{"@type":"ListItem","position":2,"name":"Blog","item":"https://pulse.smatchroom.com/blog"},{"@type":"ListItem","position":3,"name":"Comment trouver des clients quand on est artisan","item":"https://pulse.smatchroom.com/blog/trouver-des-clients-artisan"}],"@id":"https://pulse.smatchroom.com/blog/trouver-des-clients-artisan#breadcrumb"},{"@type":"Article","@id":"https://pulse.smatchroom.com/blog/trouver-des-clients-artisan#article","headline":"Comment trouver des clients quand on est artisan","description":"Les six canaux qui ramènent des chantiers à un artisan du bâtiment, ce qu'ils coûtent, et dans quel ordre les mettre en place quand on est seul.","url":"https://pulse.smatchroom.com/blog/trouver-des-clients-artisan","inLanguage":"fr-FR","datePublished":"2026-08-20T09:00:00.000Z","dateModified":"2026-08-20T09:00:00.000Z","articleSection":"Blog","author":{"@id":"https://pulse.smatchroom.com/#organization"},"publisher":{"@id":"https://pulse.smatchroom.com/#organization"},"isPartOf":{"@id":"https://pulse.smatchroom.com/#website"}}]}12:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1b"}}],["$","$L1c",null,{}],["$","article",null,{"className":"mx-auto max-w-3xl px-5 py-16 sm:px-6","children":[["$","nav",null,{"className":"mb-6 text-sm text-[var(--muted)]","children":[["$","$L1d",null,{"href":"/","children":"Accueil"}]," ",["$","span",null,{"className":"mx-2","children":"›"}],["$","$L1d",null,{"href":"/blog","children":"Blog"}]," ",["$","span",null,{"className":"mx-2","children":"›"}],["$","span",null,{"children":"Comment trouver des clients quand on est artisan"}]]}],["$","h1",null,{"className":"mb-4 text-balance text-3xl font-semibold leading-tight sm:text-4xl","children":"Comment trouver des clients quand on est artisan"}],["$","p",null,{"className":"mb-12 text-sm text-[var(--muted)]","children":["Publié le ","20/08/2026"," · ",4," min de lecture"," · ",["$","span",null,{"className":"font-mono","children":"trouver des clients artisan"}]]}],["$","div",null,{"className":"article-body","children":[["$","p",null,{"children":"Un artisan qui cherche des clients entend toujours la même réponse : « il faut communiquer ». Ça\nne veut rien dire. Il y a six canaux qui ramènent des chantiers dans le bâtiment, ils ne coûtent\npas la même chose, ils ne demandent pas le même temps, et ils ne se mettent pas en place dans\nn'importe quel ordre."}],"\n",["$","p",null,{"children":"Voici les six, dans l'ordre où nous les installons chez nos clients."}],"\n",["$","h2",null,{"id":"1-le-bouche-à-oreille-mais-organisé","children":["$","a",null,{"href":"#1-le-bouche-à-oreille-mais-organisé","children":"1. Le bouche-à-oreille, mais organisé"}]}],"\n",["$","p",null,{"children":"C'est le premier canal de tous les artisans, et le seul qui ne coûte rien. Son défaut est\nconnu : il est irrégulier. Il donne trois chantiers en mars et zéro en juillet."}],"\n","$L1e","\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","$L27","\n","$L28","\n","$L29","\n","$L2a","\n","$L2b","\n","$L2c","\n","$L2d","\n","$L2e","\n","$L2f","\n","$L30","\n","$L31","\n","$L32","\n","$L33","\n","$L34","\n","$L35","\n","$L36","\n","$L37","\n","$L38","\n","$L39","\n","$L3a","\n","$L3b"]}],"$L3c","$L3d","$undefined","$undefined"]}],"$L3e"]
:HL["/brand/pulse-picto.png","image"]
1e:["$","p",null,{"children":"Ce qui le rend régulier tient en une habitude : demander un avis Google à chaque fin de chantier,\nle jour même, pendant que le client est content. Pas une semaine après, quand il est passé à autre\nchose."}]
1f:["$","p",null,{"children":"Un artisan avec quarante avis récents n'est plus dans la même catégorie qu'un artisan avec quatre\navis de 2023, même à travail égal."}]
20:["$","h2",null,{"id":"2-la-fiche-établissement-google","children":["$","a",null,{"href":"#2-la-fiche-établissement-google","children":"2. La fiche établissement Google"}]}]
21:["$","p",null,{"children":"C'est le canal le plus rentable du bâtiment, et le plus souvent laissé à l'abandon. Un particulier\nqui a une fuite ne va pas sur un moteur de recherche pour lire des pages : il regarde la carte, il\nregarde les avis, il appelle le premier qui inspire confiance."}]
22:["$","p",null,{"children":"Trois choses à tenir : des photos de chantiers récentes, des horaires justes, et une réponse à\nchaque avis, y compris les mauvais. Une fiche vide vous fait perdre l'appel avant même qu'il ne\nsoit passé."}]
23:["$","p",null,{"children":"C'est gratuit. C'est aussi une demi-heure par semaine, ce qui explique pourquoi si peu le font."}]
24:["$","h2",null,{"id":"3-le-site-internet-à-condition-quil-nomme-les-communes","children":["$","a",null,{"href":"#3-le-site-internet-à-condition-quil-nomme-les-communes","children":"3. Le site internet, à condition qu'il nomme les communes"}]}]
25:["$","p",null,{"children":"Un site qui dit « couverture, zinguerie, isolation » sur une page d'accueil ne répond à aucune\nrecherche précise. Les gens ne tapent pas un catalogue, ils tapent une prestation et un lieu."}]
26:["$","p",null,{"children":"Ce qui fonctionne : une page par prestation, une page par commune de votre zone, des photos\navant-après, et un bouton d'appel visible en permanence sur téléphone. Le reste est décoratif."}]
27:["$","p",null,{"children":"Un site sert aussi à autre chose : il donne de la matière à Google pour vous positionner sur\nautre chose que votre nom. Sans lui, la fiche établissement plafonne vite."}]
28:["$","p",null,{"children":["Nous détaillons ce que ça contient et ce que ça coûte sur la page\n",["$","a",null,{"href":"/site-web-artisan","children":"site internet pour artisan"}],"."]}]
29:["$","h2",null,{"id":"4-les-prescripteurs-le-canal-que-presque-personne-ne-travaille","children":["$","a",null,{"href":"#4-les-prescripteurs-le-canal-que-presque-personne-ne-travaille","children":"4. Les prescripteurs, le canal que presque personne ne travaille"}]}]
2a:["$","p",null,{"children":"C'est le plus sous-estimé, et de loin le plus rentable en B2B."}]
2b:["$","p",null,{"children":"Autour de vous, des professionnels voient les chantiers avant vous : agences immobilières,\nsyndics, architectes, maîtres d'œuvre, diagnostiqueurs, assureurs, autres corps de métier. Ils ont\ntous besoin d'une entreprise fiable à recommander, et ils en manquent."}]
2c:["$","p",null,{"children":"La difficulté n'est pas de savoir qui contacter. C'est de le faire toutes les semaines, alors que\nvous êtes sur un toit. Un partenariat se construit en trois ou quatre échanges étalés sur un mois,\net c'est exactement le genre de suivi qui saute quand la journée déborde."}]
2d:["$","p",null,{"children":["C'est le travail que nous confions à un agent : il écrit à ces professionnels, un par un, avec un\nmessage qui leur est propre, relance au bon moment, et vous passe la main quand quelqu'un est\nintéressé. Le détail est sur la page ",["$","a",null,{"href":"/prospection-b2b","children":"prospection B2B"}],"."]}]
2e:["$","h2",null,{"id":"5-la-publicité-locale-sur-facebook-et-instagram","children":["$","a",null,{"href":"#5-la-publicité-locale-sur-facebook-et-instagram","children":"5. La publicité locale sur Facebook et Instagram"}]}]
2f:["$","p",null,{"children":"Elle marche dans le bâtiment à une condition : montrer le chantier. Une photo de logo ne produit\nrien. Une vidéo d'un toit refait, filmée au téléphone, diffusée aux habitants de trois communes\nautour du chantier, produit des demandes."}]
30:["$","p",null,{"children":"C'est le seul canal de la liste qui coûte de l'argent tous les mois sans jamais se capitaliser :\nle jour où vous arrêtez, les demandes s'arrêtent. Il se met en place après les quatre premiers,\npas avant."}]
31:["$","h2",null,{"id":"6-les-plateformes-de-mise-en-relation","children":["$","a",null,{"href":"#6-les-plateformes-de-mise-en-relation","children":"6. Les plateformes de mise en relation"}]}]
32:["$","p",null,{"children":"Elles ramènent du volume, vite. Elles ont trois défauts : le même besoin est vendu à plusieurs\nartisans, la concurrence se fait sur le prix, et le client appartient à la plateforme."}]
33:["$","p",null,{"children":"Elles dépannent quand le carnet est vide. Elles ne construisent rien."}]
34:["$","h2",null,{"id":"dans-quel-ordre","children":["$","a",null,{"href":"#dans-quel-ordre","children":"Dans quel ordre"}]}]
35:["$","p",null,{"children":"Si vous partez de zéro, l'ordre compte plus que le choix des canaux."}]
36:["$","ol",null,{"children":["\n",["$","li",null,{"children":"La fiche établissement Google et les avis. Gratuit, immédiat, le meilleur rapport temps-résultat."}],"\n",["$","li",null,{"children":"Le site avec les pages par commune. Il donne du poids à la fiche."}],"\n",["$","li",null,{"children":"Les prescripteurs. C'est le canal qui produit les chantiers les plus gros et les moins\nnégociés."}],"\n",["$","li",null,{"children":"La publicité Meta, seulement quand les trois premiers tournent."}],"\n"]}]
37:["$","p",null,{"children":"Les plateformes restent en dépannage, et le bouche-à-oreille s'entretient en continu."}]
38:["$","h2",null,{"id":"le-vrai-obstacle","children":["$","a",null,{"href":"#le-vrai-obstacle","children":"Le vrai obstacle"}]}]
39:["$","p",null,{"children":"Aucun de ces canaux n'est compliqué à comprendre. Ils demandent tous la même chose : de la\nrégularité, une à deux heures par semaine, indéfiniment."}]
3a:["$","p",null,{"children":"C'est ce qui manque à un artisan qui travaille seul, et c'est la seule raison pour laquelle la\nplupart des carnets de commande sont irréguliers. Ce n'est pas un problème de compétence\ncommerciale."}]
3b:["$","p",null,{"children":"Si vous voulez qu'on regarde ensemble où vous en êtes sur les six, l'appel dure trente minutes et\nn'engage à rien."}]
