f:["$","section",null,{"className":"relative px-5 py-16 sm:px-6 sm:py-20 ","children":["$","div",null,{"className":"mx-auto max-w-7xl","children":[["$","div",null,{"className":"mb-10 flex items-center gap-4","children":[["$","span",null,{"className":"section-index","children":"Métiers dominants ici"}],["$","span",null,{"className":"h-px flex-1 bg-[var(--border-strong)]"}],"$undefined"]}],["$","h2",null,{"className":"max-w-3xl text-balance text-2xl font-semibold tracking-tight sm:text-[2rem]","children":["Les métiers pour lesquels on nous appelle le plus à ","Arcachon"]}],["$","div",null,{"className":"mt-8 grid gap-6 md:grid-cols-2","children":[["$","article","couvreur",{"className":"rounded-2xl border border-[var(--border-strong)] bg-[var(--surface)] p-7","children":[["$","h3",null,{"className":"font-display text-lg font-semibold tracking-tight text-[var(--foreground)] sm:text-xl","children":"Couvreurs et charpentiers"}],["$","p",null,{"className":"mt-3 text-[0.95rem] leading-relaxed text-[var(--muted-strong)]","children":["La couverture est un métier d'urgence et de prescription. Un particulier appelle quand il a une fuite, et il appelle le premier qui décroche. Le reste du carnet se remplit par ceux qui voient les toits avant vous : syndics, assureurs, agences immobilières, experts après sinistre."," ",["$","a",null,{"href":"/metiers/couvreur","className":"font-semibold text-[var(--primary-ink)] hover:underline","children":["Voir la page ","couvreur"]}]]}]]}],["$","article","menuisier",{"className":"rounded-2xl border border-[var(--border-strong)] bg-[var(--surface)] p-7","children":[["$","h3",null,{"className":"font-display text-lg font-semibold tracking-tight text-[var(--foreground)] sm:text-xl","children":"Menuisiers et poseurs"}],["$","p",null,{"className":"mt-3 text-[0.95rem] leading-relaxed text-[var(--muted-strong)]","children":["En menuiserie, le devis est long à faire et facile à perdre. Le client compare trois offres, met deux mois à décider, et celui qui l'emporte est souvent celui qui a relancé sans être lourd. C'est exactement le travail qu'un agent fait mieux qu'un humain débordé."," ",["$","a",null,{"href":"/metiers/menuisier","className":"font-semibold text-[var(--primary-ink)] hover:underline","children":["Voir la page ","menuisier"]}]]}]]}],["$","article","peintre-facadier",{"className":"rounded-2xl border border-[var(--border-strong)] bg-[var(--surface)] p-7","children":[["$","h3",null,{"className":"font-display text-lg font-semibold tracking-tight text-[var(--foreground)] sm:text-xl","children":"Peintres et façadiers"}],["$","p",null,{"className":"mt-3 text-[0.95rem] leading-relaxed text-[var(--muted-strong)]","children":["La peinture est le métier où le volume compte le plus : beaucoup de petits chantiers, des marges serrées, et une dépendance forte à un ou deux donneurs d'ordre. Diversifier les sources est vital, et c'est un travail de contact répétitif."," ",["$","a",null,{"href":"/metiers/peintre-facadier","className":"font-semibold text-[var(--primary-ink)] hover:underline","children":["Voir la page ","peintre-façadier"]}]]}]]}],["$","article","paysagiste",{"className":"rounded-2xl border border-[var(--border-strong)] bg-[var(--surface)] p-7","children":[["$","h3",null,{"className":"font-display text-lg font-semibold tracking-tight text-[var(--foreground)] sm:text-xl","children":"Paysagistes et entretien d’espaces verts"}],["$","p",null,{"className":"mt-3 text-[0.95rem] leading-relaxed text-[var(--muted-strong)]","children":["En paysage, tout se joue sur le contrat annuel d'entretien. Un client qui signe reste plusieurs années, et le chiffre devient prévisible. Le problème, c'est que ces contrats se gagnent auprès de gestionnaires qu'on ne croise jamais sur un chantier de particulier."," ","$L1e"]}]]}]]}]]}]}]
