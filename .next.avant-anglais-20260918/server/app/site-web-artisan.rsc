13:T10ec,{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://pulse.smatchroom.com/site-web-artisan#webpage","url":"https://pulse.smatchroom.com/site-web-artisan","name":"Site internet pour artisan : création et fiche Google","description":"Création de site internet pour artisan : pages par ville et par prestation, fiche établissement Google tenue à jour. 300 € puis 20 € par mois.","inLanguage":"fr-FR","isPartOf":{"@id":"https://pulse.smatchroom.com/#website"},"about":{"@id":"https://pulse.smatchroom.com/#organization"},"breadcrumb":{"@id":"https://pulse.smatchroom.com/site-web-artisan#breadcrumb"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Accueil","item":"https://pulse.smatchroom.com/"},{"@type":"ListItem","position":2,"name":"Site internet pour artisan","item":"https://pulse.smatchroom.com/site-web-artisan"}],"@id":"https://pulse.smatchroom.com/site-web-artisan#breadcrumb"},{"@type":"Service","name":"Création de site internet pour artisan et fiche établissement Google","description":"Création de site internet pour artisan : pages par ville et par prestation, fiche établissement Google tenue à jour. 300 € puis 20 € par mois.","url":"https://pulse.smatchroom.com/site-web-artisan","@id":"https://pulse.smatchroom.com/site-web-artisan#service","serviceType":"Création de site internet pour artisan et fiche établissement Google","provider":{"@id":"https://pulse.smatchroom.com/#organization"},"areaServed":[{"@type":"AdministrativeArea","name":"Gironde"},{"@type":"AdministrativeArea","name":"Landes"},{"@type":"AdministrativeArea","name":"Pyrénées-Atlantiques"},{"@type":"AdministrativeArea","name":"Lot-et-Garonne"},{"@type":"AdministrativeArea","name":"Dordogne"},{"@type":"AdministrativeArea","name":"Charente-Maritime"},{"@type":"Country","name":"France"}],"offers":[{"@type":"Offer","name":"Fabrication","price":"300","priceCurrency":"EUR","valueAddedTaxIncluded":false,"description":"Frais de fabrication, une seule fois"},{"@type":"Offer","name":"Pilotage mensuel","priceCurrency":"EUR","valueAddedTaxIncluded":false,"priceSpecification":{"@type":"UnitPriceSpecification","price":"20","priceCurrency":"EUR","billingIncrement":1,"unitCode":"MON","unitText":"mois"}}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Combien coûte un site internet pour un artisan ?","acceptedAnswer":{"@type":"Answer","text":"300 € HT de fabrication, puis 20 € HT par mois pour l'hébergement, les mises à jour et la tenue de la fiche établissement Google. Il n'y a pas de frais cachés et pas d'engagement de durée."}},{"@type":"Question","name":"En combien de temps le site est-il en ligne ?","acceptedAnswer":{"@type":"Answer","text":"Comptez 48 heures une fois que nous avons vos photos de chantier, vos zones d'intervention et vos prestations. Le plus long n'est pas la fabrication, c'est de rassembler ces trois choses."}},{"@type":"Question","name":"Faut-il un site quand on a déjà une fiche Google ?","acceptedAnswer":{"@type":"Answer","text":"Les deux se tiennent. Une fiche établissement sans site plafonne vite : Google a peu de matière pour vous positionner sur autre chose que votre nom. Un site sans fiche est invisible dans la carte, qui est pourtant ce que voit un particulier pressé."}},{"@type":"Question","name":"Est-ce que je peux modifier le site moi-même ?","acceptedAnswer":{"@type":"Answer","text":"Les changements courants, textes, photos, prestations, zones, se demandent et sont faits dans la journée. Nous ne vous laissons pas seul devant un éditeur : c'est la raison pour laquelle la plupart des sites d'artisans ne sont jamais mis à jour."}},{"@type":"Question","name":"Que se passe-t-il si j’arrête l’abonnement ?","acceptedAnswer":{"@type":"Answer","text":"Le nom de domaine est à vous et le reste. Le site s'arrête, la fiche établissement Google reste la vôtre : elle vous appartient, nous ne faisons que la tenir."}},{"@type":"Question","name":"Vous travaillez pour quels métiers ?","acceptedAnswer":{"@type":"Answer","text":"Couvreurs, menuisiers, plombiers chauffagistes, électriciens, maçons, peintres façadiers, paysagistes et entreprises de rénovation énergétique. Un métier qui n'est pas dans la liste n'est pas un refus, c'est une question à poser."}}]}]}a:["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$13"}}],"$L14","$L15","$L16"],["$L17"],"$L18"]}]
