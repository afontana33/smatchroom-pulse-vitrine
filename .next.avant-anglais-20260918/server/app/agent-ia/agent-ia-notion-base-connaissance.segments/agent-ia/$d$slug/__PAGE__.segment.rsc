4d:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Setup et intégration"}]," : entre 490 € et plusieurs milliers d'euros selon la complexité (structuration des données, connexions API, orchestration multi-outils)"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Abonnement mensuel"}]," : de 249 €/mois (agent unique, périmètre cadré) à 690 €/mois pour une architecture multi-agents orchestrés"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Maintenance et supervision"}]," : prévoir 10 à 20 % du coût de setup annuellement pour les mises à jour de prompts, la gestion des droits et le monitoring"]}],"\n"]}]
