26:["$","p",null,{"children":["Pour une configuration multi-agents (offre Squad) : 1 490 € de setup + 690 €/mois, soit ",["$","strong",null,{"children":"9 770 € sur 12 mois"}],"."]}]
27:["$","p",null,{"children":"Aucun coût de recrutement, aucun turnover, aucune période d'onboarding prolongée. La montée en charge est paramétrique, pas humaine."}]
