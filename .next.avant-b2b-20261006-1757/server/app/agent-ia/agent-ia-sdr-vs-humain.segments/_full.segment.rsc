43:["$","p",null,{"children":["Même en appliquant un coefficient conservateur (attribution partielle, cycle de vente de 2–3 mois), le seuil de rentabilité est atteint dès ",["$","strong",null,{"children":"1 contrat signé sur la période"}],"."]}]
