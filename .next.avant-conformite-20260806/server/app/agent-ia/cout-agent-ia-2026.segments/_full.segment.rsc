30:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Coût mensuel"}]," : 50 à 300 €/mois, sans frais de setup significatifs"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Mise en place"}]," : rapide (quelques jours), sans compétences techniques"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Limites"}]," : logique arborescente rigide, incapacité à raisonner sur des données métier complexes, taux d'escalade humaine élevé (souvent >40 %)"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Adapté à"}]," : FAQ statiques, volume faible, budget contraint"]}],"\n"]}]
