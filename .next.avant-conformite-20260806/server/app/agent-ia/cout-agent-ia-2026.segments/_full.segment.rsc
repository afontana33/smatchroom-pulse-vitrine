1e:["$","p",null,{"children":["C'est le poste le plus variable — et le plus stratégique. Définir les cas d'usage, rédiger les règles métier, former les équipes : cet accompagnement conditionne directement le ROI. Il représente généralement ",["$","strong",null,{"children":"entre 20 et 40 % du setup initial"}],"."]}]
1f:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Ateliers de cadrage fonctionnel"}],"\n",["$","li",null,{"children":"Documentation des processus à automatiser"}],"\n",["$","li",null,{"children":"Formation des utilisateurs et référents internes"}],"\n"]}]
20:["$","h2",null,{"id":"coût-selon-le-type-dagent--sdr-support-ops--comparatif-2026","children":["$","a",null,{"href":"#coût-selon-le-type-dagent--sdr-support-ops--comparatif-2026","children":"Coût selon le type d'agent : SDR, support, ops — comparatif 2026"}]}]
21:["$","p",null,{"children":"Le coût d'un agent IA varie significativement selon son rôle métier. Un agent SDR (prospection sortante) implique davantage d'intégrations CRM et de personnalisation que l'agent support, lui-même plus exigeant en base de connaissances qu'un agent ops orienté automatisation interne. Voici les fourchettes observées en 2026 par cas d'usage."}]
22:["$","h3",null,{"id":"agent-sdr--prospection-et-qualification-automatisée","children":["$","a",null,{"href":"#agent-sdr--prospection-et-qualification-automatisée","children":"Agent SDR — Prospection et qualification automatisée"}]}]
23:["$","p",null,{"children":"Un agent SDR orchestre l'envoi de séquences multicanales, la qualification de leads entrants et la prise de rendez-vous. Sa complexité d'intégration (CRM, enrichissement de données, agenda) se répercute sur le coût."}]
24:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Setup"}]," : 1 200 € à 3 500 € selon le nombre de séquences et d'intégrations"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Abonnement mensuel"}]," : 500 € à 900 €"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Cas sectoriel"}]," : une PME SaaS de 20 personnes remplace l'équivalent de 0,5 ETP SDR junior, soit ~18 000 €/an économisés en coût salarial chargé"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Statistique"}]," : selon McKinsey (2024), les équipes commerciales utilisant l'IA génèrent jusqu'à 50 % de leads qualifiés supplémentaires à volume d'activité constant"]}],"\n"]}]
25:["$","h3",null,{"id":"agent-support--traitement-des-demandes-entrantes","children":["$","a",null,{"href":"#agent-support--traitement-des-demandes-entrantes","children":"Agent support — Traitement des demandes entrantes"}]}]
26:["$","p",null,{"children":"L'agent support gère les tickets, FAQ dynamiques et escalades. Son coût dépend du volume de requêtes et de la richesse de la base documentaire à indexer."}]
27:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Setup"}]," : 800 € à 2 500 €"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Abonnement mensuel"}]," : 350 € à 700 €"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Cas sectoriel"}]," : un e-commerçant B2B traitant 1 500 tickets/mois réduit le temps de traitement moyen de 8 minutes à moins de 2 minutes sur les demandes de niveau 1"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Statistique"}]," : Gartner estime qu'un ",["$","a",null,{"href":"/solutions/agent-support","children":"agent IA support"}]," bien configuré résout entre 60 % et 80 % des demandes sans intervention humaine"]}],"\n"]}]
