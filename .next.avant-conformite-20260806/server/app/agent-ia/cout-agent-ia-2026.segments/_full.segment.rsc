15:["$","p",null,{"children":["C'est le moteur de l'agent. Selon le volume de requêtes et le modèle retenu (GPT-4o, Claude 3.5, Mistral Large…), la facture d'API oscille entre ",["$","strong",null,{"children":"50 et 800 €/mois"}]," pour un usage B2B standard. Les modèles open source auto-hébergés réduisent ce coût, mais transfèrent la charge vers l'infrastructure serveur."]}]
16:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Coût à l'usage (tokens consommés) ou forfait selon le fournisseur"}],"\n",["$","li",null,{"children":"Volume de requêtes = principal levier d'optimisation"}],"\n",["$","li",null,{"children":"Choix du modèle : équilibre performance / coût à calibrer par cas d'usage"}],"\n"]}]
17:["$","h3",null,{"id":"2-intégrations-et-connecteurs","children":["$","a",null,{"href":"#2-intégrations-et-connecteurs","children":"2. Intégrations et connecteurs"}]}]
18:["$","p",null,{"children":["Un agent isolé n'a aucune valeur opérationnelle. Le connecter à votre CRM, votre helpdesk ou vos bases de données représente ",["$","strong",null,{"children":"30 à 50 % du coût de setup"}],". La complexité du SI existant est le facteur déterminant."]}]
19:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Connecteurs natifs (HubSpot, Salesforce, Zendesk) : intégration rapide"}],"\n",["$","li",null,{"children":"API propriétaires ou legacy : développement spécifique nécessaire"}],"\n",["$","li",null,{"children":"Sécurité et authentification : poste souvent sous-estimé"}],"\n"]}]
