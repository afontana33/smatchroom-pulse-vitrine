{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/commerces",
      "destination": "/entrepreneurs",
      "statusCode": 308,
      "regex": "^(?!/_next)/commerces(?:/)?$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/agent-ia/[slug]",
      "regex": "^/agent\\-ia/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/agent\\-ia/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/blog/[slug]",
      "regex": "^/blog/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/blog/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/solutions/[slug]",
      "regex": "^/solutions/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/solutions/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/agent-ia",
      "regex": "^/agent\\-ia(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/agent\\-ia(?:/)?$"
    },
    {
      "page": "/artisans",
      "regex": "^/artisans(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/artisans(?:/)?$"
    },
    {
      "page": "/blog",
      "regex": "^/blog(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/blog(?:/)?$"
    },
    {
      "page": "/cgv",
      "regex": "^/cgv(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/cgv(?:/)?$"
    },
    {
      "page": "/confidentialite",
      "regex": "^/confidentialite(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/confidentialite(?:/)?$"
    },
    {
      "page": "/entrepreneurs",
      "regex": "^/entrepreneurs(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/entrepreneurs(?:/)?$"
    },
    {
      "page": "/entreprises",
      "regex": "^/entreprises(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/entreprises(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/grands-comptes",
      "regex": "^/grands\\-comptes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/grands\\-comptes(?:/)?$"
    },
    {
      "page": "/partenaires",
      "regex": "^/partenaires(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/partenaires(?:/)?$"
