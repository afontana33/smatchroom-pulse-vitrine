11:T1090,{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://pulse.smatchroom.com/apporteur-affaires#webpage","url":"https://pulse.smatchroom.com/apporteur-affaires","name":"Trouver des apporteurs d’affaires : l’Agent Partenaires","description":"Un agent contacte par WhatsApp et email les prescripteurs qui ont déjà vos clients : agences, cabinets, consultants. 149 € HT/mois, sans engagement.","inLanguage":"fr-FR","isPartOf":{"@id":"https://pulse.smatchroom.com/#website"},"about":{"@id":"https://pulse.smatchroom.com/#organization"},"breadcrumb":{"@id":"https://pulse.smatchroom.com/apporteur-affaires#breadcrumb"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Accueil","item":"https://pulse.smatchroom.com/"},{"@type":"ListItem","position":2,"name":"Apporteurs d’affaires","item":"https://pulse.smatchroom.com/apporteur-affaires"}],"@id":"https://pulse.smatchroom.com/apporteur-affaires#breadcrumb"},{"@type":"Service","name":"Agent Partenaires : recherche d’apporteurs d’affaires","description":"Un agent contacte par WhatsApp et email les prescripteurs qui ont déjà vos clients : agences, cabinets, consultants. 149 € HT/mois, sans engagement.","url":"https://pulse.smatchroom.com/apporteur-affaires","@id":"https://pulse.smatchroom.com/apporteur-affaires#service","serviceType":"Agent Partenaires : recherche d’apporteurs d’affaires","provider":{"@id":"https://pulse.smatchroom.com/#organization"},"areaServed":[{"@type":"AdministrativeArea","name":"Gironde"},{"@type":"AdministrativeArea","name":"Landes"},{"@type":"AdministrativeArea","name":"Pyrénées-Atlantiques"},{"@type":"AdministrativeArea","name":"Lot-et-Garonne"},{"@type":"AdministrativeArea","name":"Dordogne"},{"@type":"AdministrativeArea","name":"Charente-Maritime"},{"@type":"Country","name":"France"}],"offers":[{"@type":"Offer","name":"Fabrication","priceCurrency":"EUR","valueAddedTaxIncluded":false,"description":"Frais de fabrication, une seule fois","price":"0"},{"@type":"Offer","name":"Pilotage mensuel","priceCurrency":"EUR","valueAddedTaxIncluded":false,"priceSpecification":{"@type":"UnitPriceSpecification","price":"149","priceCurrency":"EUR","billingIncrement":1,"unitCode":"MON","unitText":"mois"}}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Qu’est-ce qu’un apporteur d’affaires ?","acceptedAnswer":{"@type":"Answer","text":"Un professionnel qui voit passer vos futurs clients avant vous et vous les recommande : l'agent immobilier qui vend une maison à rénover, l'assureur qui gère un sinistre, l'architecte qui cherche une entreprise. Un seul bon prescripteur peut amener plusieurs chantiers ou contrats par an."}},{"@type":"Question","name":"Combien coûte l’Agent Partenaires ?","acceptedAnswer":{"@type":"Answer","text":"149 € HT par mois, sans frais de création et sans engagement. Aucun rendez-vous dans le mois ? Le mois suivant ne vous est pas facturé. Il est aussi inclus dans le Pack Lancement : site, fiche Google et 3 mois d'agent pour 490 € HT."}},{"@type":"Question","name":"Quelle différence avec l’Agent Clients ?","acceptedAnswer":{"@type":"Answer","text":"L'Agent Partenaires contacte les prescripteurs, ceux qui ont déjà vos clients. L'Agent Clients contacte directement vos clients potentiels, des décideurs en entreprise : il est fait pour les sociétés qui vendent à d'autres entreprises."}},{"@type":"Question","name":"Les messages partent de mon numéro ?","acceptedAnswer":{"@type":"Answer","text":"Oui, de votre WhatsApp et de votre boîte mail, signés de votre prénom. Les prescripteurs vous répondent directement, et vous voyez chaque conversation sur votre téléphone."}},{"@type":"Question","name":"Je risque un blocage de mon WhatsApp ?","acceptedAnswer":{"@type":"Answer","text":"Le volume monte progressivement, quelques messages par jour au départ, avec un rythme humain et uniquement aux heures de bureau. Un « stop » arrête tout, définitivement."}},{"@type":"Question","name":"En combien de temps ça démarre ?","acceptedAnswer":{"@type":"Answer","text":"48 heures après le cadrage pour les premiers messages. Les premières réponses arrivent en général dans la semaine."}}]}]}a:["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$11"}}],"$L12","$L13","$L14"],["$L15"],"$L16"]}]
