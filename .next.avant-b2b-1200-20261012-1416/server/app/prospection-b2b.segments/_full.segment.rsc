11:T179a,{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://pulse.smatchroom.com/prospection-b2b#webpage","url":"https://pulse.smatchroom.com/prospection-b2b","name":"Agence de prospection B2B : signaux d’achat, WhatsApp et email","description":"Un agent repère les entreprises prêtes à acheter, contacte leurs décideurs par WhatsApp et email, et passe la main à vos commerciaux. Dès 340 € HT/mois.","inLanguage":"fr-FR","isPartOf":{"@id":"https://pulse.smatchroom.com/#website"},"about":{"@id":"https://pulse.smatchroom.com/#organization"},"breadcrumb":{"@id":"https://pulse.smatchroom.com/prospection-b2b#breadcrumb"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Accueil","item":"https://pulse.smatchroom.com/"},{"@type":"ListItem","position":2,"name":"Prospection B2B","item":"https://pulse.smatchroom.com/prospection-b2b"}],"@id":"https://pulse.smatchroom.com/prospection-b2b#breadcrumb"},{"@type":"Service","name":"Agent Clients B2B","description":"Base de données construite sur mesure pour votre marché, agent entraîné sur votre catalogue et vos objections, qualification du besoin, du budget et du calendrier avant transmission à vos commerciaux.","url":"https://pulse.smatchroom.com/prospection-b2b","@id":"https://pulse.smatchroom.com/prospection-b2b#service","serviceType":"Agent Clients B2B","provider":{"@id":"https://pulse.smatchroom.com/#organization"},"areaServed":[{"@type":"AdministrativeArea","name":"Gironde"},{"@type":"AdministrativeArea","name":"Landes"},{"@type":"AdministrativeArea","name":"Pyrénées-Atlantiques"},{"@type":"AdministrativeArea","name":"Lot-et-Garonne"},{"@type":"AdministrativeArea","name":"Dordogne"},{"@type":"AdministrativeArea","name":"Charente-Maritime"},{"@type":"Country","name":"France"}],"offers":[{"@type":"Offer","name":"Fabrication","priceCurrency":"EUR","valueAddedTaxIncluded":false,"description":"Frais de fabrication, une seule fois","priceSpecification":{"@type":"PriceSpecification","minPrice":"490","priceCurrency":"EUR","valueAddedTaxIncluded":false}},{"@type":"Offer","name":"Pilotage mensuel","priceCurrency":"EUR","valueAddedTaxIncluded":false,"priceSpecification":{"@type":"UnitPriceSpecification","price":"340","priceCurrency":"EUR","billingIncrement":1,"unitCode":"MON","unitText":"mois"}}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Combien coûte une agence de prospection B2B ?","acceptedAnswer":{"@type":"Answer","text":"Chez nous, deux formules. L'agent de prospection est à 149 € HT par mois, sans frais de création ni engagement. L'Agent Clients B2B, avec base de données sur mesure et qualification avant transmission aux commerciaux, démarre à 490 € HT de fabrication puis 340 € HT par mois avec un numéro WhatsApp (environ 300 décideurs par mois), 640 € HT par mois avec 2 à 3 numéros, et sur devis au-delà. Pas de commission au rendez-vous, pas de facturation à la performance."}},{"@type":"Question","name":"Quelle différence avec un SDR ou un commercial junior ?","acceptedAnswer":{"@type":"Answer","text":"Le coût et la régularité. Un agent ne prend pas de retard sur les relances, ne décroche pas, et ne perd pas le fil d'une conversation de trois semaines. En revanche il ne négocie pas et ne signe rien : il amène l'interlocuteur qualifié jusqu'à votre commercial, qui garde la vente."}},{"@type":"Question","name":"D’où viennent les contacts ?","acceptedAnswer":{"@type":"Answer","text":"De données publiques : fiches Google, registres d'entreprises, offres d'emploi, annuaires professionnels et publications LinkedIn. Nous n'achetons pas de fichiers et nous ne collectons pas de données de particuliers. Chaque contact est rattaché à une entreprise identifiée."}},{"@type":"Question","name":"Qu’est-ce qu’un signal d’achat ?","acceptedAnswer":{"@type":"Answer","text":"Un indice qu'une entreprise a une raison d'acheter maintenant : elle recrute, vient de se créer, change de dirigeant, ouvre un site, ou l'un de ses décideurs réagit sur LinkedIn à un sujet lié à votre offre. L'agent contacte ces entreprises en priorité."}},{"@type":"Question","name":"Pourquoi WhatsApp et email plutôt que LinkedIn ?","acceptedAnswer":{"@type":"Answer","text":"Les messageries LinkedIn sont saturées de sollicitations. LinkedIn sert à repérer, WhatsApp et l'email à contacter : c'est là que les décideurs répondent encore."}},{"@type":"Question","name":"Vous garantissez des résultats ?","acceptedAnswer":{"@type":"Answer","text":"Aucun rendez-vous dans le mois ? Le mois suivant ne vous est pas facturé. La garantie porte sur les mensualités, pas sur la mise en place."}},{"@type":"Question","name":"Est-ce que c’est légal, et conforme au RGPD ?","acceptedAnswer":{"@type":"Answer","text":"La prospection entre professionnels est autorisée si l'objet du message concerne l'activité de la personne contactée, si l'expéditeur est identifiable et si l'opposition est possible et immédiate. Les trois sont tenues. Le caractère automatisé de l'envoi est mentionné, et toute opposition est définitive."}},{"@type":"Question","name":"Combien de messages par jour ?","acceptedAnswer":{"@type":"Answer","text":"On démarre bas et on monte progressivement. Un volume élevé dès le premier jour fait tomber le canal, quelle que soit la qualité du message. Le rythme se règle avec vous, il n'est jamais imposé."}},{"@type":"Question","name":"Qu’est-ce que je relis avant que ça parte ?","acceptedAnswer":{"@type":"Answer","text":"Les premiers messages, systématiquement. Ensuite vous gardez la main : vous voyez les conversations en cours et vous pouvez reprendre n'importe laquelle à tout moment."}},{"@type":"Question","name":"En combien de temps est-ce en service ?","acceptedAnswer":{"@type":"Answer","text":"48 heures pour un agent branché sur des données publiques. Une connexion à votre CRM ou à votre ERP demande plus de cadrage, et la fourchette est donnée après le premier échange."}}]}]}a:["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$11"}}],"$L12","$L13","$L14"],["$L15"],"$L16"]}]
