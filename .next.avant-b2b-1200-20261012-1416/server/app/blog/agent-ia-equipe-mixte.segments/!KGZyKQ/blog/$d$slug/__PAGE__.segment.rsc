31:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Taux de résolution autonome"}]," : part des demandes traitées intégralement par l'agent, sans intervention humaine. Un agent support bien calibré atteint 55 à 70 % dès le premier mois (estimation prudente sur périmètre cadré)."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Temps de traitement moyen (TTR)"}]," : comparez le TTR avant/après déploiement sur les tâches déléguées. Un delta inférieur à 20 % signale un problème de paramétrage."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Taux d'escalade"}]," : proportion de conversations renvoyées vers un humain. Un taux supérieur à 40 % en semaine 4 indique un périmètre trop large ou une base de connaissance insuffisante."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Taux d'erreur ou de réponse hors-sujet"}]," : à monitorer manuellement sur un échantillon hebdomadaire, surtout en phase pilote."]}],"\n"]}]
