3d:["$","p",null,{"children":"Un éditeur RH a déployé un agent de support de niveau 1 pour traiter les demandes répétitives (réinitialisation de compte, questions de facturation, statut de ticket)."}]
3e:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Résultat estimé"}]," : 45 % des tickets résolus sans intervention humaine au bout de 6 semaines"]}],"\n",["$","li",null,{"children":"Délai de première réponse ramené de 4 h à moins de 2 minutes"}],"\n",["$","li",null,{"children":"Les agents humains traitent désormais exclusivement les cas complexes ou sensibles"}],"\n",["$","li",null,{"children":"Satisfaction client maintenue : score CSAT stable à +4,2/5"}],"\n"]}]
