29:["$","p",null,{"children":"Une fois le pilote validé, la montée en charge suit un rythme trimestriel :"}]
2a:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Mois 2–3"}]," : extension à l'ensemble de l'équipe concernée, ajustement des règles de routage"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Mois 4–6"}]," : ajout d'un second cas d'usage adjacent (ex. : relances → onboarding)"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Mois 6+"}]," : interconnexion avec vos outils CRM, helpdesk ou ERP selon les priorités métier"]}],"\n"]}]
2b:["$","h3",null,{"id":"ce-quil-ne-faut-pas-négliger","children":["$","a",null,{"href":"#ce-quil-ne-faut-pas-négliger","children":"Ce qu'il ne faut pas négliger"}]}]
2c:["$","p",null,{"children":"Deux facteurs organisationnels conditionnent la réussite autant que la technique :"}]
2d:["$","ul",null,{"children":["\n",["$","li",null,{"children":["Désigner un ",["$","strong",null,{"children":"référent interne"}]," (pas nécessairement technique) chargé du suivi opérationnel"]}],"\n",["$","li",null,{"children":["Prévoir une ",["$","strong",null,{"children":"session de feedback équipe"}]," à J+15 et J+30 pour ajuster les comportements de l'agent"]}],"\n"]}]
