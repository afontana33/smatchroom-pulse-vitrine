23:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Segmenter"}]," une base de contacts selon des critères statiques ou comportementaux (secteur, score de lead, étape du funnel)"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Envoyer des séquences email"}]," espacées dans le temps selon un calendrier fixe"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Scorer les leads"}]," automatiquement à partir de règles de pondération définies manuellement"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Déclencher des alertes"}]," vers l'équipe commerciale quand un contact atteint un seuil de score"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Synchroniser les données"}]," avec un CRM (Salesforce, Pipedrive) pour centraliser le suivi"]}],"\n"]}]
24:["$","p",null,{"children":"En B2B, un cas d'usage typique : un prospect télécharge un cas client → il entre dans un workflow de 5 emails sur 3 semaines → à l'email 3, s'il clique sur la page tarifs, un commercial reçoit une notification. Ce scénario fonctionne bien — à condition que le prospect suive exactement le chemin anticipé."}]
25:["$","h3",null,{"id":"les-limites-structurelles-du-marketing-automation","children":["$","a",null,{"href":"#les-limites-structurelles-du-marketing-automation","children":"Les limites structurelles du marketing automation"}]}]
26:["$","p",null,{"children":["Selon Forrester, ",["$","strong",null,{"children":"63 % des équipes marketing B2B"}]," estiment que leurs workflows d'automation deviennent obsolètes dans les 6 mois suivant leur déploiement, faute de maintenance."]}]
27:["$","p",null,{"children":"Les contraintes sont structurelles :"}]
28:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Rigidité des workflows"}]," : tout comportement non prévu dans l'arbre de décision est ignoré"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Personnalisation limitée"}]," : les variables disponibles (prénom, entreprise, secteur) restent superficielles"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Absence de raisonnement"}]," : l'outil ne comprend pas le contexte d'un échange, il lit des conditions booléennes"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Dépendance à la donnée propre"}]," : un champ CRM mal renseigné casse le déclencheur"]}],"\n"]}]
29:["$","p",null,{"children":"Ces limites ne disqualifient pas le marketing automation — elles définissent son périmètre d'efficacité."}]
2a:["$","h2",null,{"id":"ce-que-fait-réellement-un-agent-ia-autonome","children":["$","a",null,{"href":"#ce-que-fait-réellement-un-agent-ia-autonome","children":"Ce que fait réellement un agent IA autonome"}]}]
2b:["$","p",null,{"children":["Un agent IA autonome ne se contente pas d'exécuter une séquence prédéfinie : il ",["$","strong",null,{"children":"raisonne"}],", ",["$","strong",null,{"children":"décide"}]," et ",["$","strong",null,{"children":"agit"}]," en chaîne pour atteindre un objectif, sans intervention humaine à chaque étape. C'est ce qui le distingue fondamentalement d'un chatbot à arbre de décision ou d'un workflow d'automation classique."]}]
2c:["$","h3",null,{"id":"raisonnement-mémoire-et-action-enchaînée","children":["$","a",null,{"href":"#raisonnement-mémoire-et-action-enchaînée","children":"Raisonnement, mémoire et action enchaînée"}]}]
2d:["$","p",null,{"children":"Concrètement, un agent IA fonctionne selon une boucle en trois temps :"}]
2e:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Perception"}]," : il ingère des données contextuelles (historique CRM, comportement sur le site, réponse à un e-mail, heure d'envoi, secteur d'activité du prospect)."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Raisonnement"}]," : il évalue la situation, sélectionne la meilleure action parmi plusieurs options possibles et anticipe les conséquences."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Action"}]," : il exécute — rédige un message personnalisé, met à jour un champ CRM, déclenche une alerte commerciale, ou escalade vers un humain si la situation le justifie."]}],"\n"]}]
2f:["$","p",null,{"children":"Cette boucle se répète et s'adapte à chaque nouvelle information reçue. Selon les estimations de Gartner (2024), moins de 15 % des entreprises B2B utilisent aujourd'hui des agents capables d'enchaîner plus de trois actions autonomes — ce qui représente un levier de différenciation significatif."}]
