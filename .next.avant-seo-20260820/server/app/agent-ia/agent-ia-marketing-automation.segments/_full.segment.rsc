5f:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Moins de 5 personnes"}]," : une plateforme d'automation (Brevo, Mailchimp) couvre l'essentiel des besoins de nurturing à moindre coût."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"5 à 20 personnes"}]," : un agent IA sur un périmètre ciblé (qualification entrante, relances) libère du temps sans nécessiter une refonte complète."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Plus de 20 personnes"}]," : les architectures hybrides deviennent pertinentes — automation pour les volumes, agent IA pour les interactions à forte valeur."]}],"\n"]}]
