31:["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{}],["$","th",null,{"children":"Chatbot classique"}],["$","th",null,{"children":"Workflow automatisé"}],["$","th",null,{"children":"Agent IA autonome"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":"Déclenchement"}],["$","td",null,{"children":"Mot-clé ou bouton"}],["$","td",null,{"children":"Événement fixe"}],["$","td",null,{"children":"Contexte interprété"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Adaptabilité"}],["$","td",null,{"children":"Aucune"}],["$","td",null,{"children":"Limitée aux branches prévues"}],["$","td",null,{"children":"Continue, en temps réel"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Prise de décision"}],["$","td",null,{"children":"Arbre figé"}],["$","td",null,{"children":"Règles statiques"}],["$","td",null,{"children":"Raisonnement dynamique"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Mémoire"}],["$","td",null,{"children":"Session uniquement"}],["$","td",null,{"children":"Partielle"}],["$","td",null,{"children":"Persistante et exploitable"}]]}]]}]]}]
32:["$","p",null,{"children":["Un agent IA peut, par exemple, identifier qu'un prospect a consulté trois fois une page tarifaire en 48 heures, croiser cette information avec son profil ICP, rédiger un message de relance contextualisé ",["$","strong",null,{"children":"et"}]," notifier le commercial concerné — sans qu'aucune règle explicite n'ait été programmée pour ce scénario précis."]}]
33:["$","p",null,{"children":["C'est cette capacité à traiter l'",["$","strong",null,{"children":"imprévu"}]," qui constitue la rupture réelle avec les outils d'automation traditionnels."]}]
