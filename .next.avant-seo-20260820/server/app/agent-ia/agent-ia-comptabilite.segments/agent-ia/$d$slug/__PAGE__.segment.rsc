2:T4a1,{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://pulse.smatchroom.com/agent-ia/agent-ia-comptabilite#webpage","url":"https://pulse.smatchroom.com/agent-ia/agent-ia-comptabilite","name":"Agent IA comptabilité : automatiser saisie et clôture B2B","description":"Découvrez comment un agent IA en comptabilité automatise la saisie, le rapprochement bancaire et la clôture comptable dans votre PME B2B. Gain de temps garanti.","inLanguage":"fr-FR","isPartOf":{"@id":"https://pulse.smatchroom.com/#website"},"about":{"@id":"https://pulse.smatchroom.com/#organization"},"breadcrumb":{"@id":"https://pulse.smatchroom.com/agent-ia/agent-ia-comptabilite#breadcrumb"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Accueil","item":"https://pulse.smatchroom.com/"},{"@type":"ListItem","position":2,"name":"Ressources agent IA","item":"https://pulse.smatchroom.com/agent-ia"},{"@type":"ListItem","position":3,"name":"Agent IA comptabilité : automatiser vos processus B2B","item":"https://pulse.smatchroom.com/agent-ia/agent-ia-comptabilite"}],"@id":"https://pulse.smatchroom.com/agent-ia/agent-ia-comptabilite#breadcrumb"}]}0:{"rsc":["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","$L3",null,{}],["$","article",null,{"className":"mx-auto max-w-3xl px-6 py-16 prose prose-invert","children":[["$","nav",null,{"className":"text-sm text-neutral-400 mb-6","children":[["$","$L4",null,{"href":"/","children":"Accueil"}]," ",["$","span",null,{"className":"mx-2","children":"›"}],["$","$L4",null,{"href":"/agent-ia","children":"Agent IA"}]," ",["$","span",null,{"className":"mx-2","children":"›"}],["$","span",null,{"children":"Agent IA comptabilité : automatiser vos processus B2B"}]]}],["$","h1",null,{"className":"text-4xl font-semibold leading-tight mb-4","children":"Agent IA comptabilité : automatiser vos processus B2B"}],["$","p",null,{"className":"text-sm text-neutral-400 mb-12","children":["Publié le ","24/05/2026"," · ",12," min de lecture"," · ",["$","span",null,{"className":"font-mono","children":"agent ia comptabilité"}]]}],["$","div",null,{"className":"article-body","children":[["$","p",null,{"children":["Un agent IA comptabilité automatise trois processus clés dans une PME B2B : la ",["$","strong",null,{"children":"saisie des pièces comptables"}]," (factures, notes de frais) par extraction OCR, le ",["$","strong",null,{"children":"rapprochement bancaire"}]," en comparant automatiquement relevés et écritures, et la ",["$","strong",null,{"children":"clôture comptable"}]," en orchestrant les tâches de fin de période et en détectant les anomalies. Il s'intègre aux logiciels existants (Sage, Pennylane, Cegid) et réduit significativement le temps passé sur des tâches répétitives à faible valeur ajoutée."]}],"\n",["$","h2",null,{"id":"ce-quun-agent-ia-comptabilité-fait-concrètement-dans-une-pme-b2b","children":["$","a",null,{"href":"#ce-quun-agent-ia-comptabilité-fait-concrètement-dans-une-pme-b2b","children":"Ce qu'un agent IA comptabilité fait concrètement dans une PME B2B"}]}],"\n",["$","p",null,{"children":["Un agent IA comptabilité n'est pas un simple formulaire intelligent. C'est un système capable de ",["$","strong",null,{"children":"raisonner, d'agir en séquence et de s'adapter"}]," aux règles propres à votre organisation — plan comptable, centres de coûts, flux fournisseurs."]}],"\n",["$","p",null,{"children":"Dans une PME B2B, son périmètre fonctionnel couvre concrètement :"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Saisie automatique"}]," : lecture et extraction des données depuis factures PDF, e-mails, EDI, puis imputation comptable sans intervention manuelle"]}],"\n","$L5","\n","$L6","\n","$L7","\n"]}],"\n","$L8","\n","$L9","\n","$La","\n","$Lb","\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c","\n","$L1d","\n","$L1e","\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","$L27","\n","$L28","\n","$L29","\n","$L2a","\n","$L2b","\n","$L2c","\n","$L2d","\n","$L2e","\n","$L2f","\n","$L30","\n","$L31","\n","$L32","\n","$L33","\n","$L34","\n","$L35","\n","$L36","\n","$L37","\n","$L38","\n","$L39","\n","$L3a","\n","$L3b","\n","$L3c","\n","$L3d","\n","$L3e","\n","$L3f","\n","$L40","\n","$L41","\n","$L42","\n","$L43","\n","$L44","\n","$L45","\n","$L46","\n","$L47","\n","$L48","\n","$L49","\n","$L4a"]}],"$L4b","$L4c","$L4d","$L4e"]}],"$L4f"],["$L50"],"$L51"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"lJq45fIE2o5f4WvRLOzhK"}
5:["$","li",null,{"children":[["$","strong",null,{"children":"Rapprochement bancaire"}]," : comparaison des relevés bancaires avec les écritures, lettrage automatique des comptes tiers"]}]
6:["$","li",null,{"children":[["$","strong",null,{"children":"Clôture mensuelle et annuelle"}]," : exécution d'une checklist structurée, relances internes, détection d'écritures manquantes ou incohérentes"]}]
7:["$","li",null,{"children":[["$","strong",null,{"children":"Coordination avec l'expert-comptable"}]," : transmission automatisée des dossiers de révision, avec piste d'audit complète"]}]
8:["$","p",null,{"children":["Selon une estimation prudente, ces trois processus représentent ",["$","strong",null,{"children":"40 à 60 % du temps opérationnel"}]," d'un service comptable en PME. C'est précisément ce volume que l'agent prend en charge, en laissant aux équipes les décisions à valeur ajoutée : analyse, arbitrage, relation client."]}]
9:["$","h2",null,{"id":"saisie-automatique-des-pièces-comptables--comment-ça-fonctionne","children":["$","a",null,{"href":"#saisie-automatique-des-pièces-comptables--comment-ça-fonctionne","children":"Saisie automatique des pièces comptables : comment ça fonctionne"}]}]
a:["$","p",null,{"children":"La saisie automatique repose sur une chaîne de trois opérations enchaînées sans intervention humaine : reconnaissance optique des documents (OCR), extraction structurée des données, puis écriture dans le logiciel comptable ou l'ERP. Le résultat : chaque facture fournisseur, note de frais ou avoir reçu est traité en quelques secondes, sans ressaisie manuelle."}]
b:["$","h3",null,{"id":"de-la-pièce-brute-à-lécriture-comptable--les-étapes-clés","children":["$","a",null,{"href":"#de-la-pièce-brute-à-lécriture-comptable--les-étapes-clés","children":"De la pièce brute à l'écriture comptable : les étapes clés"}]}]
c:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Capture du document"}]," — la pièce arrive par e-mail, portail fournisseur ou dépôt manuel (PDF, image, scan). L'agent la détecte et l'ingère automatiquement."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"OCR et extraction intelligente"}]," — le moteur lit le document et identifie les champs structurants : numéro de facture, date, montant HT/TVA, IBAN, SIRET fournisseur, libellé de prestation."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Contrôle de cohérence"}]," — l'agent vérifie les totaux, détecte les doublons et signale les anomalies (TVA incohérente, fournisseur inconnu) avant toute écriture."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Imputation comptable automatique"}]," — le compte de charge, le tiers et l'analytique sont affectés selon les règles paramétrées (plan comptable, centres de coût)."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Injection dans le logiciel cible"}]," — l'écriture est poussée via API ou connecteur natif vers Pennylane, Sage, Cegid ou Sellsy, sans double saisie."]}],"\n"]}]
d:["$","h3",null,{"id":"ce-que-ça-change-sur-le-terrain","children":["$","a",null,{"href":"#ce-que-ça-change-sur-le-terrain","children":"Ce que ça change sur le terrain"}]}]
e:["$","p",null,{"children":["Selon les estimations sectorielles, la saisie manuelle d'une facture fournisseur mobilise entre ",["$","strong",null,{"children":"3 et 8 minutes"}]," selon sa complexité. Sur un volume de 300 factures mensuelles — courant dans une PME B2B de taille intermédiaire — cela représente jusqu'à ",["$","strong",null,{"children":"40 heures/mois"}]," absorbées par une tâche à faible valeur ajoutée."]}]
f:["$","p",null,{"children":"Un agent IA ramène ce temps à quelques minutes de contrôle supervisé, avec un taux d'erreur structurellement inférieur à la saisie humaine répétitive."}]
10:["$","h2",null,{"id":"rapprochement-bancaire-et-lettrage--les-tâches-les-plus-chronophages-enfin-déléguées","children":["$","a",null,{"href":"#rapprochement-bancaire-et-lettrage--les-tâches-les-plus-chronophages-enfin-déléguées","children":"Rapprochement bancaire et lettrage : les tâches les plus chronophages enfin déléguées"}]}]
11:["$","p",null,{"children":"Le rapprochement bancaire et le lettrage des comptes représentent, dans la plupart des PME B2B, entre 30 % et 40 % du temps de traitement comptable mensuel — selon les estimations terrain des cabinets d'expertise comptable. Ce sont précisément ces tâches répétitives, à faible valeur ajoutée mais à fort risque d'erreur, qu'un agent IA prend en charge en priorité."}]
12:["$","p",null,{"children":["$","strong",null,{"children":"Ce que l'agent traite automatiquement :"}]}]
13:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Comparaison ligne à ligne entre les relevés bancaires et les écritures du grand livre"}],"\n",["$","li",null,{"children":"Identification et proposition de lettrage pour les règlements partiels ou les paiements groupés"}],"\n",["$","li",null,{"children":"Détection des doublons, des écarts de montant et des transactions non rapprochées"}],"\n",["$","li",null,{"children":"Classement automatique des opérations récurrentes (loyers, abonnements, remboursements de frais)"}],"\n",["$","li",null,{"children":"Génération d'un rapport d'anomalies priorisé, transmis au comptable pour validation finale"}],"\n"]}]
14:["$","p",null,{"children":["$","strong",null,{"children":"Résultats observés sur des périmètres similaires :"}]}]
15:["$","p",null,{"children":"Un distributeur B2B traitant 800 à 1 200 transactions bancaires par mois peut atteindre un taux de rapprochement automatique supérieur à 85 %, réduisant le temps de traitement humain de plusieurs heures à quelques dizaines de minutes. Dans le secteur des services professionnels, où les règlements partiels et les acomptes sont fréquents, l'agent apprend les schémas de paiement propres à chaque client et affine ses propositions de lettrage au fil des cycles."}]
16:["$","p",null,{"children":"L'agent ne remplace pas le jugement du comptable : il lui soumet uniquement les cas ambigus, documentés et contextualisés. Le contrôle humain reste le point de validation final — ce qui renforce, plutôt qu'il ne fragilise, la fiabilité des comptes."}]
17:["$","h2",null,{"id":"clôture-comptable-mensuelle-et-annuelle--réduire-les-délais-sans-sacrifier-la-fiabilité","children":["$","a",null,{"href":"#clôture-comptable-mensuelle-et-annuelle--réduire-les-délais-sans-sacrifier-la-fiabilité","children":"Clôture comptable mensuelle et annuelle : réduire les délais sans sacrifier la fiabilité"}]}]
18:["$","p",null,{"children":["Selon une étude KPMG, les PME consacrent en moyenne ",["$","strong",null,{"children":"5 à 8 jours ouvrés"}]," à leur clôture mensuelle — un délai que les entreprises équipées d'un agent IA ramènent à ",["$","strong",null,{"children":"2 à 3 jours"}],", sans dégradation de la fiabilité des données."]}]
19:["$","h3",null,{"id":"une-checklist-de-clôture-pilotée-automatiquement","children":["$","a",null,{"href":"#une-checklist-de-clôture-pilotée-automatiquement","children":"Une checklist de clôture pilotée automatiquement"}]}]
1a:["$","p",null,{"children":"L'agent IA prend en charge l'enchaînement des tâches récurrentes sans intervention manuelle :"}]
1b:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Vérification de l'exhaustivité des pièces"}]," : factures manquantes, notes de frais en attente, avoirs non comptabilisés"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Contrôle des soldes intermédiaires"}]," : cohérence entre les comptes de tiers et la balance générale"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Calcul automatique des provisions"}]," : abonnements, charges à payer, produits constatés d'avance"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Génération des états de synthèse"}]," : balance âgée, grand-livre, tableau de bord de clôture"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Notification des parties prenantes"}]," : alertes automatiques vers le DAF ou l'expert-comptable dès que le dossier est prêt"]}],"\n"]}]
1c:["$","h3",null,{"id":"détection-danomalies-avant-quelles-deviennent-des-problèmes","children":["$","a",null,{"href":"#détection-danomalies-avant-quelles-deviennent-des-problèmes","children":"Détection d'anomalies avant qu'elles deviennent des problèmes"}]}]
1d:["$","p",null,{"children":"L'agent analyse les écarts statistiques entre périodes : une charge qui double sans justification, un compte de TVA déséquilibré, un fournisseur facturé deux fois. Ces signaux sont remontés avec leur niveau de criticité, ce qui permet à votre équipe de traiter en priorité les points bloquants plutôt que de relire l'intégralité des écritures."}]
1e:["$","h3",null,{"id":"coordination-fluide-avec-lexpert-comptable","children":["$","a",null,{"href":"#coordination-fluide-avec-lexpert-comptable","children":"Coordination fluide avec l'expert-comptable"}]}]
1f:["$","p",null,{"children":"Le dossier de clôture est transmis dans un format structuré — pièces jointes indexées, anomalies documentées, écritures d'inventaire pré-renseignées. L'expert-comptable intervient sur la valeur ajoutée (analyse, conseil fiscal) plutôt que sur la collecte de données. Pour les PME en cabinet, cela réduit sensiblement les honoraires liés aux travaux de préparation."}]
20:["$","h2",null,{"id":"agent-ia-vs-solutions-comptables-traditionnelles--ce-qui-change-vraiment","children":["$","a",null,{"href":"#agent-ia-vs-solutions-comptables-traditionnelles--ce-qui-change-vraiment","children":"Agent IA vs solutions comptables traditionnelles : ce qui change vraiment"}]}]
21:["$","p",null,{"children":"Les solutions comptables traditionnelles — modules RPA basiques ou chatbots no-code — automatisent des tâches isolées selon des règles fixes. Un agent IA orchestré, lui, raisonne sur le contexte, enchaîne plusieurs actions de façon autonome et s'adapte aux exceptions sans intervention humaine systématique."}]
22:["$","h3",null,{"id":"ce-que-les-approches-traditionnelles-font-bien","children":["$","a",null,{"href":"#ce-que-les-approches-traditionnelles-font-bien","children":"Ce que les approches traditionnelles font bien"}]}]
23:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Automatisation de tâches répétitives à règles stables (export de fichiers, envoi de rappels)"}],"\n",["$","li",null,{"children":"Déploiement rapide sur un périmètre très cadré"}],"\n",["$","li",null,{"children":"Coût d'entrée faible pour des besoins unitaires"}],"\n"]}]
24:["$","h3",null,{"id":"là-où-lagent-ia-change-la-donne","children":["$","a",null,{"href":"#là-où-lagent-ia-change-la-donne","children":"Là où l'agent IA change la donne"}]}]
25:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Gestion des exceptions"}]," : une facture mal formatée, un libellé ambigu ou un taux de TVA inhabituel sont interprétés, pas bloqués"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Orchestration multi-étapes"}]," : l'agent enchaîne saisie, rapprochement et alerte sans qu'un humain relance chaque étape"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Apprentissage contextuel"}]," : il intègre les règles propres à votre plan comptable, vos fournisseurs récurrents, vos centres de coûts"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Interaction en langage naturel"}]," : vos équipes interrogent l'agent comme un collaborateur (\"Quelles factures fournisseurs sont en attente de validation ce mois-ci ?\")"]}],"\n"]}]
26:["$","h3",null,{"id":"un-indicateur-concret","children":["$","a",null,{"href":"#un-indicateur-concret","children":"Un indicateur concret"}]}]
27:["$","p",null,{"children":"Selon les estimations de cabinets spécialisés en automatisation financière, les modules RPA classiques atteignent un taux d'automatisation de 60 à 70 % sur la saisie — les 30 % restants, souvent les cas complexes, retombent sur les équipes. Un agent IA orchestré vise 85 à 92 % de traitement autonome sur ce même périmètre."}]
28:["$","p",null,{"children":"La différence n'est pas technologique dans l'absolu : elle est opérationnelle. Moins de files d'attente humaines, moins de corrections en bout de chaîne, une clôture qui avance sans relances internes."}]
29:["$","h2",null,{"id":"intégration-dans-votre-stack-existante--erp-logiciels-comptables-outils-métier","children":["$","a",null,{"href":"#intégration-dans-votre-stack-existante--erp-logiciels-comptables-outils-métier","children":"Intégration dans votre stack existante : ERP, logiciels comptables, outils métier"}]}]
2a:["$","p",null,{"children":"Un agent IA comptabilité ne remplace pas vos outils en place — il s'y connecte. La compatibilité couvre les principaux logiciels utilisés par les PME B2B françaises, avec des délais de déploiement mesurés en semaines, non en mois."}]
2b:["$","h3",null,{"id":"logiciels-et-erp-compatibles","children":["$","a",null,{"href":"#logiciels-et-erp-compatibles","children":"Logiciels et ERP compatibles"}]}]
2c:["$","p",null,{"children":"Les connecteurs disponibles couvrent notamment :"}]
2d:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Sage 50, Sage 100"}]," — import/export de journaux, synchronisation des tiers"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Pennylane"}]," — API native, lecture et écriture des écritures comptables"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Cegid Loop / Cegid Expert"}]," — intégration via flux structurés et webhooks"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Sellsy"}]," — synchronisation des factures clients et des règlements"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"ERP sur mesure"}]," — connexion via API REST ou SFTP pour les environnements propriétaires"]}],"\n"]}]
2e:["$","h3",null,{"id":"ce-que-lintégration-implique-concrètement","children":["$","a",null,{"href":"#ce-que-lintégration-implique-concrètement","children":"Ce que l'intégration implique concrètement"}]}]
2f:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Un audit technique préalable de 3 à 5 jours pour cartographier vos flux existants"}],"\n",["$","li",null,{"children":"Une phase de paramétrage des règles métier (plan comptable, centres de coût, TVA)"}],"\n",["$","li",null,{"children":"Des tests de recette sur données réelles avant mise en production"}],"\n",["$","li",null,{"children":"Aucune modification de votre logiciel comptable actuel : l'agent opère en surcouche"}],"\n"]}]
30:["$","h3",null,{"id":"pilote-vs-squad--quel-périmètre-choisir-","children":["$","a",null,{"href":"#pilote-vs-squad--quel-périmètre-choisir-","children":"Pilote vs Squad : quel périmètre choisir ?"}]}]
31:["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Formule"}],["$","th",null,{"children":"Périmètre"}],["$","th",null,{"children":"Délai de déploiement estimé"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":[["$","strong",null,{"children":"Pilote"}]," (249 €/mois)"]}],["$","td",null,{"children":"1 agent, 1 périmètre cadré (ex. : rapprochement bancaire)"}],["$","td",null,{"children":"3 à 4 semaines"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":[["$","strong",null,{"children":"Squad"}]," (690 €/mois)"]}],["$","td",null,{"children":"Plusieurs agents orchestrés (saisie + rapprochement + alertes clôture)"}],["$","td",null,{"children":"6 à 8 semaines"}]]}]]}]]}]
32:["$","p",null,{"children":"Selon les retours terrain observés sur des déploiements comparables, environ 80 % des PME atteignent un fonctionnement nominal dès la fin du premier mois en formule Pilote. Le périmètre Squad convient aux structures traitant plus de 500 écritures mensuelles ou gérant plusieurs entités juridiques."}]
33:["$","h2",null,{"id":"coûts-roi-et-délai-de-retour-sur-investissement-pour-une-pme-b2b","children":["$","a",null,{"href":"#coûts-roi-et-délai-de-retour-sur-investissement-pour-une-pme-b2b","children":"Coûts, ROI et délai de retour sur investissement pour une PME B2B"}]}]
34:["$","p",null,{"children":"Pour une PME B2B traitant 200 à 500 pièces comptables par mois, le déploiement d'un agent IA comptabilité représente un investissement mensuel compris entre 249 € et 690 €, selon le périmètre retenu. Le seuil de rentabilité est généralement atteint entre 6 et 10 semaines après mise en production."}]
35:["$","h3",null,{"id":"ce-que-coûte-réellement-un-agent-ia-comptabilité","children":["$","a",null,{"href":"#ce-que-coûte-réellement-un-agent-ia-comptabilité","children":"Ce que coûte réellement un agent IA comptabilité"}]}]
36:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Offre Pilote"}]," : 249 €/mois + 490 € de setup — 1 agent, périmètre cadré (ex. : saisie automatique ou rapprochement bancaire)"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Offre Squad"}]," : 690 €/mois + 1 490 € de setup — plusieurs agents orchestrés (saisie + lettrage + alertes de clôture)"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Offre Custom"}]," : sur devis, pour les périmètres multi-entités ou les intégrations ERP complexes"]}],"\n"]}]
37:["$","h3",null,{"id":"heures-économisées--une-estimation-prudente","children":["$","a",null,{"href":"#heures-économisées--une-estimation-prudente","children":"Heures économisées : une estimation prudente"}]}]
38:["$","p",null,{"children":["Selon les retours terrain observés sur des PME B2B de 10 à 50 salariés, un agent IA comptabilité permet d'économiser ",["$","strong",null,{"children":"entre 8 et 20 heures par mois"}]," sur les tâches de saisie, rapprochement et préparation de clôture. À un coût horaire chargé de 35 €, cela représente ",["$","strong",null,{"children":"280 à 700 € de valeur récupérée chaque mois"}],"."]}]
