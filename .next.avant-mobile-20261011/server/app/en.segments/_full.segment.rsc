11:T15e7,{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://pulse.smatchroom.com/en#webpage","url":"https://pulse.smatchroom.com/en","name":"B2B prospecting agents for sales teams · SmatchRoom Pulse","description":"We build and run the AI agent that works your B2B market: custom database, personalised outreach, need and budget qualified before your reps step in.","inLanguage":"en","isPartOf":{"@id":"https://pulse.smatchroom.com/#website"},"about":{"@id":"https://pulse.smatchroom.com/#organization"}},{"@type":"Service","name":"B2B prospecting agent","description":"A database built for your market, an agent trained on your catalogue and your objections, and the need, budget and timeline qualified before the conversation reaches your sales team.","url":"https://pulse.smatchroom.com/en","@id":"https://pulse.smatchroom.com/en#service","serviceType":"B2B prospecting agent","provider":{"@id":"https://pulse.smatchroom.com/#organization"},"areaServed":[{"@type":"AdministrativeArea","name":"Gironde"},{"@type":"AdministrativeArea","name":"Landes"},{"@type":"AdministrativeArea","name":"Pyrénées-Atlantiques"},{"@type":"AdministrativeArea","name":"Lot-et-Garonne"},{"@type":"AdministrativeArea","name":"Dordogne"},{"@type":"AdministrativeArea","name":"Charente-Maritime"},{"@type":"Country","name":"France"}],"offers":[{"@type":"Offer","name":"Fabrication","priceCurrency":"EUR","valueAddedTaxIncluded":false,"description":"Frais de fabrication, une seule fois","priceSpecification":{"@type":"PriceSpecification","minPrice":"490","priceCurrency":"EUR","valueAddedTaxIncluded":false}},{"@type":"Offer","name":"Pilotage mensuel","priceCurrency":"EUR","valueAddedTaxIncluded":false,"priceSpecification":{"@type":"UnitPriceSpecification","price":"340","priceCurrency":"EUR","billingIncrement":1,"unitCode":"MON","unitText":"mois"}}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What exactly do you build?","acceptedAnswer":{"@type":"Answer","text":"One agent, built for your market. It assembles the list of companies worth contacting from public sources, writes to each of them individually rather than sending a mail merge, follows up at sensible intervals, answers replies in under a minute seven days a week, and qualifies the need, the budget and the timeline before handing the conversation to your sales team. You are not buying access to a platform: we build it, we run it, and you talk to us."}},{"@type":"Question","name":"How much does it cost?","acceptedAnswer":{"@type":"Answer","text":"The build fee is from €490 excl. VAT, paid once, and the monthly fee is quoted after the audit. That is deliberate: the size of the market to build, the number of decision-makers to reach and the integrations involved change the work by an order of magnitude, so a single fixed monthly price would either overcharge the small scopes or cap the large ones. There is no commission per meeting and no pay-per-result billing."}},{"@type":"Question","name":"Do you guarantee results?","acceptedAnswer":{"@type":"Answer","text":"No, and nobody serious can. The number of deals also depends on your market, your prices and how your team follows up. What we do commit to is the work: the agreed contact volume genuinely goes out, replies are handled in under a minute, and you see all of it. If the wording is not landing, we rewrite it at no extra cost. We would rather turn down a brief we do not believe in than promise a number."}},{"@type":"Question","name":"Which countries and languages do you cover?","acceptedAnswer":{"@type":"Answer","text":"Today the agents run in France, Belgium and Luxembourg, in French. Other markets and other languages are taken case by case, and we will say so on the audit call rather than after you have signed: phone number formats, postcode rules and the local rules on business outreach all have to be handled properly before a single message is sent."}},{"@type":"Question","name":"Where do the contacts come from?","acceptedAnswer":{"@type":"Answer","text":"Public sources: company registers, professional directories, open data for your sector. We do not buy contact files and we do not collect consumer data. Every contact is attached to an identified company, which is what keeps business-to-business outreach lawful in the EU."}},{"@type":"Question","name":"Do the people contacted know they are talking to an AI?","acceptedAnswer":{"@type":"Answer","text":"Yes, and it is a legal requirement. Since 2 August 2026, Article 50 of the EU AI Act requires that anyone interacting with an AI system be informed of it. Our agents state it in the first message, stop for good when someone replies STOP, and hand the conversation to a person on request. This disclosure cannot be removed at a client's request: it is written into our terms of service."}},{"@type":"Question","name":"Is our data, and our prospects' data, protected?","acceptedAnswer":{"@type":"Answer","text":"Yes. Your agent runs on dedicated infrastructure rather than shared software, and one client's data is never mixed with another's. A data processing agreement compliant with Article 28 of the GDPR is attached to the contract and signed as a matter of course."}},{"@type":"Question","name":"What if it does not suit us?","acceptedAnswer":{"@type":"Answer","text":"You stop. There is no lock-in on the monthly fee: you tell us, the next month is not charged, and you keep what was produced, including your contact base. If you would rather talk to someone before committing to anything, call us on +33 7 71 48 76 98 and you will get us, not a support queue."}}]}]}a:["$","$1","c",{"children":[["$","main",null,{"className":"flex flex-col","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$11"}}],"$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a"]}],["$L1b","$L1c"],"$L1d"]}]
